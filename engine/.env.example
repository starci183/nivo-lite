# NIVO engine: every variable the process reads. Copy to engine/.env for local runs, or set them in deploy/.env on the VPS
# (deploy/.env.example lists the same engine variables plus the stack ones). Never commit real values.
# `<NAME>_FILE=/path` is accepted for every value (Docker/Compose secrets): the file content is the value.

# ---- database (required). The SERVICE ROLE key: full access, server only.
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_SERVICE_ROLE_KEY=

# ---- the control plane (required)
# Base URL of the Next.js app, no trailing slash. Local: http://127.0.0.1:3100
NIVO_BASE_URL=http://127.0.0.1:3100
# 32+ chars, the SAME value as ENGINE_SHARED_SECRET in the app. Signs engine<->app calls and derives tool-token / n8n signing keys.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENGINE_SHARED_SECRET=
# Seconds the app waits for the engine to answer one call (default 55)
NIVO_TIMEOUT_MS=55000

# ---- the worker
ENGINE_WORKER_ID=
ENGINE_POLL_MS=2000
ENGINE_CONCURRENCY=4
# A claimed job is leased this long; the worker renews it every third of that. Dead worker = job re-claimed after the lease.
ENGINE_LEASE_SECONDS=60
ENGINE_SHUTDOWN_GRACE_MS=30000

# ---- HTTP (health + tool bridge)
ENGINE_HOST=127.0.0.1
ENGINE_PORT=8787
# How OpenClaw reaches the tool bridge (OpenClaw runs next to the engine). Default http://127.0.0.1:<ENGINE_PORT>
ENGINE_TOOLS_URL=

# ---- OpenClaw gateway (empty = not configured: every chat.turn uses the direct-model fallback)
OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789
# One of the two, whichever the gateway is configured with:
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_GATEWAY_PASSWORD=
# How long one customer turn may take before the app answers directly instead (5000..600000)
OPENCLAW_TURN_TIMEOUT_MS=90000
# Opt-in: create the workspace agents in openclaw.json on the shared volume (confirm the schema for your OpenClaw version first)
OPENCLAW_MANAGE_AGENTS=0
OPENCLAW_CONFIG_DIR=

# ---- n8n.emit
# Where events go when a job names no URL, e.g. the n8n service in the compose network
N8N_DEFAULT_WEBHOOK_URL=
# Comma-separated hosts allowed although private (the n8n service name). Any other target must resolve to a public address.
N8N_ALLOWED_HOSTS=n8n
N8N_EMIT_TIMEOUT_MS=10000
