{
  "name": "@nivo/engine",
  "version": "0.1.0",
  "private": true,
  "description": "NIVO engine: the long-running worker (durable job queue, OpenClaw, n8n) that runs on a VPS next to the Next.js control plane.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "tsc -p tsconfig.build.json --watch",
    "dev:mock-openclaw": "node dev/mock-openclaw.mjs",
    "dev:e2e": "node dev/e2e.mjs"
  },
  "dependencies": {
    "@nestjs/common": "11.2.5",
    "@nestjs/core": "11.2.5",
    "@nestjs/platform-express": "11.2.5",
    "@supabase/supabase-js": "2.117.2",
    "fflate": "0.8.3",
    "mammoth": "1.13.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "unpdf": "1.8.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "4.17.25",
    "@types/node": "22.20.4",
    "@types/ws": "^8.5.12",
    "typescript": "5.9.3"
  }
}
