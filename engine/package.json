{
  "name": "@nivo/engine",
  "version": "0.1.0",
  "private": true,
  "description": "NIVO engine: the long-running worker (durable job queue, OpenClaw, n8n) that runs on a VPS next to the Next.js control plane.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "tsc -p tsconfig.build.json --watch",
    "dev:mock-openclaw": "node dev/mock-openclaw.mjs",
    "dev:e2e": "node dev/e2e.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@supabase/supabase-js": "^2.57.0",
    "msedge-tts": "^2.0.8",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.12",
    "typescript": "^5.6.0"
  }
}
