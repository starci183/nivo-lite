# NIVO engine stack: EVERY variable docker-compose.yml reads. Copy to deploy/.env ON THE VPS (chmod 600) and fill it in.
# deploy.sh never copies this file unless you ask it to (DEPLOY_PUSH_ENV=1). Never commit real values.
# Generate a secret:  openssl rand -hex 32

# ---- domain and TLS
# Apex domain you control. The stack serves n8n.<DOMAIN> and engine.<DOMAIN>; both need DNS A/AAAA records to the VPS.
DOMAIN=example.com
# Contact address for Let's Encrypt expiry notices
ACME_EMAIL=ops@example.com
# Who may open the n8n editor (space separated CIDRs). Webhooks /webhook/* stay public. Default: everyone.
# Tip: set it to your own address for the very first start, create the n8n owner account, then widen it if needed.
N8N_ALLOWED_CIDRS=0.0.0.0/0 ::/0

# ---- engine (same names as engine/.env.example)
# Supabase Cloud project URL and its SERVICE ROLE key (Project settings > API). Full access: keep it only here.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# The Next.js app, no trailing slash (the control plane the engine calls back)
NIVO_BASE_URL=https://app.example.com
# 32+ chars. THE SAME VALUE must be set as ENGINE_SHARED_SECRET in the app (Netlify environment variables).
ENGINE_SHARED_SECRET=
ENGINE_WORKER_ID=vps-1
ENGINE_CONCURRENCY=4
ENGINE_POLL_MS=1000
ENGINE_LEASE_SECONDS=60
ENGINE_SHUTDOWN_GRACE_MS=30000
ENGINE_VERSION=latest
# Seconds one customer turn may take through OpenClaw before the app answers directly (5000..600000)
OPENCLAW_TURN_TIMEOUT_MS=90000
# 1 = the engine registers the synced ws-<id>-<module> agents in openclaw.json (agents.list) and writes their workspaces (openclaw.sync_agent)
OPENCLAW_MANAGE_AGENTS=1

# ---- OpenClaw
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw
# Pin a tag you tested (the protocol notes were measured on 2026.7.1)
OPENCLAW_TAG=2026.7.1
# Shared secret between OpenClaw and the engine. openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=
# Model provider key(s) for the agents. The app's DEEPSEEK_API_KEY is really an OpenRouter key: put it in OPENROUTER_API_KEY.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- n8n
N8N_TAG=1.64.3
# Encrypts the credentials stored in n8n. Losing it means re-entering every credential. openssl rand -hex 32
N8N_ENCRYPTION_KEY=
N8N_DB_PASSWORD=
# Where n8n.emit sends events when a job names no URL. Create a Webhook node with this path in n8n first.
N8N_DEFAULT_WEBHOOK_URL=http://n8n:5678/webhook/nivo-events
# Private hosts the engine may call (the n8n service name). Any other webhook target must resolve to a public address.
N8N_ALLOWED_HOSTS=n8n

# Model the OpenClaw agents use by default, as OpenClaw spells it: openrouter/<vendor>/<model> goes through OPENROUTER_API_KEY.
OPENCLAW_MODEL=openrouter/deepseek/deepseek-v4-flash

# ---- public doors (Traefik in Docker, the ~/nivo-edge project; see deploy/edge/)
# Address the published ports bind to: 127.0.0.1 = private, 172.29.0.1 = the Docker bridge the Traefik edge container can reach
N8N_BIND=127.0.0.1
ENGINE_BIND=127.0.0.1
# n8n behind HTTPS
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_SECURE_COOKIE=false
