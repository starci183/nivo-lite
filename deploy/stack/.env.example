# Compose interpolation file of the stack (deploy/.env on the VPS). It holds NON-SECRET settings only: image tags, the bind address and the
# watchdog thresholds. The deploy job writes it from the `stack` member of .starcistacks/production/secrets (only the keys below are copied:
# deploy/materialize.mjs STACK_SETTINGS) and appends API_TAG. Every secret (gateway token, n8n keys, database password, provider keys) is a
# file under ./secrets/{api,stack} read through `<NAME>_FILE`; a manual run materializes them first:
#   SOPS_AGE_KEY=... node deploy/materialize.mjs files --env production --out <dir>
# then API_TAG=<tag> docker compose --env-file .env up -d

# ---- api container (set by the deploy workflow)
API_TAG=

# ---- OpenClaw
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw
# Pin a tag you tested (the protocol notes were measured on 2026.7.1)
OPENCLAW_TAG=2026.7.1
# Model the OpenClaw agents use by default, as OpenClaw spells it: openrouter/<vendor>/<model> goes through OPENROUTER_API_KEY.
OPENCLAW_MODEL=openrouter/deepseek/deepseek-v4-flash

# ---- n8n (private: no public host; the editor is reached through an SSH tunnel to 127.0.0.1:5678)
N8N_TAG=1.64.3
# Private hosts the api may call (the n8n service name). Any other webhook target must resolve to a public address.
N8N_ALLOWED_HOSTS=n8n

# ---- public door (Traefik in Docker, the ~/nivo-edge project; see deploy/edge/)
# Address the api port binds to. Default: the bridge address of this host, which the edge container reaches. 127.0.0.1 = private.
API_BIND=172.29.0.1

# ---- watchdog thresholds (deploy/stack/watchdog.sh): alert when this many jobs failed in 24 h, or a job has waited in its queue this long
JOBS_FAILED_ALERT=20
JOBS_STALE_SECONDS=300
