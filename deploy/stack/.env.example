# NIVO stack (OpenClaw + n8n + the api container wiring): EVERY variable docker-compose.yml reads. Copy to deploy/.env ON THE VPS (chmod 600).
# The CI deploy writes this file from the GitHub secret ENGINE_ENV (scripts/env-sync.mjs). Never commit real values.
# The api's own runtime environment is a second file, api.env (see api.env.example): it is not read from here.
# Generate a secret:  openssl rand -hex 32

# ---- domain and TLS (only for the optional caddy profile "public"; the Traefik edge in deploy/edge normally owns 80/443)
DOMAIN=example.com
ACME_EMAIL=ops@example.com
N8N_ALLOWED_CIDRS=0.0.0.0/0 ::/0

# ---- api container (set by the deploy workflow; a manual run exports it: API_TAG=<tag> docker compose --env-file .env up -d)
API_TAG=

# ---- OpenClaw
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw
# Pin a tag you tested (the protocol notes were measured on 2026.7.1)
OPENCLAW_TAG=2026.7.1
# Shared secret between OpenClaw and the api. openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=
# Model provider key(s) for the agents.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Model the OpenClaw agents use by default, as OpenClaw spells it: openrouter/<vendor>/<model> goes through OPENROUTER_API_KEY.
OPENCLAW_MODEL=openrouter/deepseek/deepseek-v4-flash

# ---- n8n
N8N_TAG=1.64.3
# Encrypts the credentials stored in n8n. Losing it means re-entering every credential. openssl rand -hex 32
N8N_ENCRYPTION_KEY=
N8N_DB_PASSWORD=
# Private hosts the api may call (the n8n service name). Any other webhook target must resolve to a public address.
N8N_ALLOWED_HOSTS=n8n
# n8n behind HTTPS
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_SECURE_COOKIE=false

# ---- public doors (Traefik in Docker, the ~/nivo-edge project; see deploy/edge/)
# Address the published ports bind to: 127.0.0.1 = private, 172.29.0.1 = the Docker bridge the Traefik edge container can reach.
# API_BIND replaces the engine-era ENGINE_BIND (still honoured when API_BIND is unset).
N8N_BIND=127.0.0.1
API_BIND=127.0.0.1

# ---- watchdog thresholds (deploy/stack/watchdog.sh): alert when this many jobs failed in 24 h, or a job has waited in its queue this long
JOBS_FAILED_ALERT=20
JOBS_STALE_SECONDS=300
