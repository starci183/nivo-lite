# Runtime environment of the api container (compose service "api", env_file api.env). Copy to deploy/api.env ON THE VPS (chmod 600).
# The CI deploy writes it from the GitHub secret API_ENV (scripts/env-sync.mjs). Never commit real values. PORT, OPENCLAW_GATEWAY_*,
# OPENCLAW_CONFIG_DIR and N8N_ALLOWED_HOSTS are set by docker-compose.yml itself.
# A missing required key stops the process at boot with the key's name and no value.

# ---- http
# Browser origins allowed to call the api (comma separated, no trailing slash). Pin to the product hosts.
HTTP_SECURITY_ALLOWED_ORIGINS=https://nivo.vn,https://www.nivo.vn
# Optional tunables (literal defaults in the code): HTTP_SECURITY_RATE_WINDOW, HTTP_SECURITY_RATE_DEFAULT_LIMIT, HTTP_SECURITY_RATE_STRICT_LIMIT

# ---- database (least-privilege role app_be on the Supabase project; set its password once with: alter role app_be password '...')
PRIMARY_DB_URL=postgresql://app_be:PASSWORD@HOST:5432/postgres
PRIMARY_DB_SCHEMA=public

# ---- Supabase (Auth and Storage only, through the supabase integration)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ---- queues and jobs (pgmq in the same database); optional tunables with literal defaults:
# QUEUE_RELAY_INTERVAL, QUEUE_RELAY_BATCH, QUEUE_CONCURRENCY, QUEUE_POLL_INTERVAL, QUEUE_VISIBILITY_TIMEOUT, JOBS_LEASE, JOBS_WORKER_ID

# ---- providers: every lane adds its keys here as it lands (webhook secrets, OAuth clients, model keys, token-encryption key).
# <PROVIDER>_WEBHOOK_SECRET and <PROVIDER>_WEBHOOK_TOLERANCE follow the http-security convention; the cutover runbook
# (be/docs/runbooks/cutover.md) lists the checklist that is current when you deploy.
