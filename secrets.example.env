# Copy to ~/.nivo-lite/secrets.env (outside the repo; override with NIVO_SECRETS). Never commit real values.
# Google OAuth client (NIVO). Add redirect URI: http://127.0.0.1:55321/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
# DeepSeek (model deepseek-flash = DeepSeek-V4.1-Flash)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Local Supabase (values printed by `supabase status`; ports are the defaults + 1000)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only: invites, demo accounts, session listing. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Public site URL used in invite links
NEXT_PUBLIC_SITE_URL=http://localhost:3100
# Invite email over SMTP (local: Inbucket). Leave empty to rely on "Copy invite link".
SMTP_URL=smtp://127.0.0.1:55325
SMTP_FROM=NIVO <no-reply@nivo.local>
# Local only: a signed-in user with no membership gets their own workspace (owner). Leave empty in production.
NIVO_ALLOW_WORKSPACE_SIGNUP=1
# Local demo sign-in (localhost only)
NEXT_PUBLIC_DEMO_LOGIN=1
DEMO_EMAIL=demo@nivo.local
DEMO_PASSWORD=
DEMO_STAFF_PASSWORD=
# SePay bank-transfer payments (lane A6). Webhook: POST https://<site>/api/sepay/webhook with "Authorization: Apikey <SEPAY_WEBHOOK_API_KEY>".
SEPAY_WEBHOOK_API_KEY=
SEPAY_BANK_ACCOUNT=
SEPAY_BANK_CODE=
SEPAY_ACCOUNT_NAME=
# AES-256-GCM key (32 random bytes, base64) that encrypts each workspace's Telegram bot token at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))". Losing it means bots must be reconnected.
CHANNEL_TOKEN_KEY=
# NIVO engine (the worker at /engine on a VPS). One shared secret, 32+ chars, same value in the app and in engine/.env.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))". Leave empty to keep every module on the default processor.
ENGINE_SHARED_SECRET=
