# Copy to ~/.nivo-prototype/secrets.env (outside the repo). Never commit real values.
# Google OAuth client (NIVO). Add redirect URI: http://127.0.0.1:54321/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
# DeepSeek (model deepseek-flash = DeepSeek-V4.1-Flash)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Local Supabase (values printed by `supabase status`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Local demo sign-in (localhost only)
NEXT_PUBLIC_DEMO_LOGIN=1
DEMO_EMAIL=demo@nivo.local
DEMO_PASSWORD=
