# Template for secrets.env (repo root, gitignored). Copy to secrets.env and fill in. Same sections as the real file.
# scripts/with-secrets.mjs reads secrets.env; scripts/env-sync.mjs pushes the [engine] block to GitHub secret ENGINE_ENV.


# ---------- [app] Next.js on Netlify + Supabase Cloud
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=https://nivo.vn
CHANNEL_TOKEN_KEY=
NIVO_PLATFORM_ADMINS=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://openrouter.ai/api/v1
DEEPSEEK_MODEL=deepseek/deepseek-v4-flash
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
SMTP_URL=
SMTP_FROM=
SEPAY_WEBHOOK_API_KEY=
SEPAY_BANK_ACCOUNT=
SEPAY_BANK_CODE=
SEPAY_ACCOUNT_NAME=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
BANK_WEBHOOK_SECRET=
# Meta (Facebook Pages + Instagram). One Meta app for all of NIVO: App ID/secret from developers.facebook.com, a verify token you invent
# (the same string goes into the app's Webhooks > Verify token). META_LOGIN_CONFIG_ID is optional (Facebook Login for Business configuration).
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_VERSION=v21.0
META_LOGIN_CONFIG_ID=
META_SEND_PER_MINUTE=60
NEXT_PUBLIC_DEMO_LOGIN=
DEMO_EMAIL=
DEMO_PASSWORD=
DEMO_STAFF_PASSWORD=

# ---------- [engine] VPS docker stack: engine, OpenClaw, n8n (this block = GitHub secret ENGINE_ENV)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NIVO_BASE_URL=https://nivo.vn
ENGINE_SHARED_SECRET=
ENGINE_WORKER_ID=vps-1
ENGINE_CONCURRENCY=4
ENGINE_POLL_MS=1000
ENGINE_LEASE_SECONDS=60
ENGINE_SHUTDOWN_GRACE_MS=30000
# Background jobs (BullMQ, docs/JOBS.md): the redis service of the engine stack. Local dev: redis://127.0.0.1:56379.
REDIS_URL=redis://redis:6379
JOBS_CONCURRENCY=4
JOBS_WORKSPACE_CONCURRENCY=2
ENGINE_VERSION=latest
OPENCLAW_TURN_TIMEOUT_MS=90000
OPENCLAW_MANAGE_AGENTS=1
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw
OPENCLAW_TAG=2026.7.1
OPENCLAW_GATEWAY_TOKEN=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
N8N_TAG=1.64.3
N8N_ENCRYPTION_KEY=
N8N_DB_PASSWORD=
N8N_DEFAULT_WEBHOOK_URL=http://n8n:5678/webhook/nivo-events
N8N_ALLOWED_HOSTS=n8n
OPENCLAW_MODEL=openrouter/deepseek/deepseek-v4-flash
# BullMQ job system (knowledge jobs). Redis is the compose service "redis"; the engine reaches it by that name.
REDIS_URL=redis://redis:6379
# Knowledge handlers. Leave these empty to inherit the [app] values (env-sync copies CHANNEL_TOKEN_KEY, the Google OAuth client
# from SUPABASE_AUTH_EXTERNAL_GOOGLE_* and OPENROUTER_API_KEY from DEEPSEEK_API_KEY); set them only to override on the VPS.
EMBEDDING_MODEL=qwen/qwen3-embedding-8b
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_API_KEY=
CHANNEL_TOKEN_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Watchdog thresholds (see engine/deploy/watchdog.sh): alert when this many BullMQ jobs sit in failed, or the outbox is not relayed for this long.
JOBS_FAILED_ALERT=20
OUTBOX_STALE_SECONDS=300
N8N_BIND=172.29.0.1
ENGINE_BIND=172.29.0.1
N8N_HOST=n8n.nivo.vn
N8N_PROTOCOL=https
N8N_WEBHOOK_URL=https://n8n.nivo.vn/
N8N_SECURE_COOKIE=true

# ---------- [accounts] ready accounts on production (Spa Hoa Mai)
READY_OWNER_EMAIL=
READY_OWNER_PASSWORD=
READY_STAFF_EMAIL=
READY_STAFF_PASSWORD=

# ---------- [vps] SSH; key files are in .secrets/ next to this file
VPS_HOST=
VPS_USER=nivo
VPS_SSH_KEY=.secrets/vps_ed25519
VPS_CI_SSH_KEY=.secrets/ci_ed25519
VPS_KNOWN_HOSTS=.secrets/vps_known_hosts

# ---------- [cloudflare] DNS for nivo.vn (engine/deploy/dns-rollback.mjs)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE=nivo.vn

# ---------- [perf] optional: PERF_LOG=1 prints, per request, every Supabase call (method + path + ms), the sequential depth and a TOTAL line.
# Set it on the server (Netlify env / the VPS .env) only while measuring.
# PERF_LOG=1
