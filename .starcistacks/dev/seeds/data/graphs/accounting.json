{
    "schema": "nivo/agent-graph@1",
    "moduleKey": "accounting",
    "contract": {
        "inputs": [
            {
                "name": "transactionId",
                "type": "string",
                "required": false
            },
            {
                "name": "conversationId",
                "type": "string",
                "required": false
            },
            {
                "name": "text",
                "type": "string",
                "required": false
            },
            {
                "name": "leadId",
                "type": "string",
                "required": false
            },
            {
                "name": "channel",
                "type": "string",
                "required": false
            }
        ]
    },
    "triggers": [
        {
            "key": "sepay",
            "source": {
                "kind": "sepay",
                "connectionId": null
            }
        },
        {
            "key": "call",
            "source": {
                "kind": "workflow",
                "connectionId": null
            }
        }
    ],
    "outcomes": [],
    "entry": {
        "openTo": "any"
    },
    "trigger": {
        "kind": "tag",
        "sources": [
            "agent",
            "system-event"
        ],
        "burst": {
            "agent": {
                "window": "0s"
            },
            "system-event": {
                "window": "0s"
            }
        }
    },
    "grant": {
        "rights": [
            {
                "kind": "bank-transaction",
                "access": "read",
                "scope": "workspace",
                "fields": [
                    "id",
                    "amountVnd",
                    "reference",
                    "payer",
                    "occurredAt",
                    "orderId",
                    "status"
                ]
            },
            {
                "kind": "order",
                "access": "read",
                "scope": "workspace",
                "fields": [
                    "id",
                    "orderNo",
                    "leadId",
                    "items",
                    "amountVnd",
                    "status",
                    "confirmedAt",
                    "createdAt"
                ]
            },
            {
                "kind": "payment-claim",
                "access": "read",
                "scope": "workspace",
                "fields": [
                    "id",
                    "leadId",
                    "conversationId",
                    "amountVnd",
                    "names",
                    "body",
                    "claimedAt",
                    "status"
                ]
            },
            {
                "kind": "sales-lead",
                "access": "read",
                "scope": "workspace",
                "fields": [
                    "id",
                    "contactName"
                ]
            },
            {
                "kind": "payment-claim",
                "access": "write",
                "scope": "turn",
                "fields": [
                    "leadId",
                    "amountVnd",
                    "names",
                    "body"
                ]
            },
            {
                "kind": "message",
                "access": "write",
                "scope": "turn",
                "fields": [
                    "body"
                ]
            },
            {
                "kind": "order",
                "access": "write",
                "scope": "workspace",
                "fields": [
                    "status"
                ]
            },
            {
                "kind": "bank-transaction",
                "access": "write",
                "scope": "workspace",
                "fields": [
                    "orderId"
                ]
            }
        ],
        "tools": [
            "nivo.ledger.entry.append"
        ],
        "effects": [
            "nivo.payment.claim.record",
            "nivo.lead.message.send",
            "nivo.payment.order.settle",
            "nivo.team.message.post",
            "nivo.agent.tag"
        ]
    },
    "nodes": [
        {
            "key": "match",
            "kind": "execute",
            "step": "accounting.match-payment",
            "params": {
                "transactionId": {
                    "$ref": "trigger.transactionId",
                    "default": null
                },
                "conversationId": {
                    "$ref": "trigger.conversationId",
                    "default": null
                },
                "text": {
                    "$ref": "trigger.text",
                    "default": null
                },
                "leadId": {
                    "$ref": "trigger.leadId",
                    "default": null
                }
            },
            "routes": {
                "matched": "mark-paid"
            },
            "model": "claude-sonnet-5-5"
        },
        {
            "key": "mark-paid",
            "kind": "output",
            "step": "payment.settle",
            "params": {
                "orderId": {
                    "$ref": "steps.match.output.orderId"
                },
                "transactionId": {
                    "$ref": "steps.match.output.transactionId"
                },
                "verdict": {
                    "$ref": "steps.match.output.verdict"
                },
                "expectedVnd": {
                    "$ref": "steps.match.output.expectedVnd"
                },
                "receivedVnd": {
                    "$ref": "steps.match.output.receivedVnd"
                }
            },
            "next": "ledger",
            "model": "claude-sonnet-5-5"
        },
        {
            "key": "ledger",
            "kind": "output",
            "step": "accounting.post-payment",
            "params": {
                "transactionId": {
                    "$ref": "steps.match.output.transactionId"
                },
                "orderId": {
                    "$ref": "steps.mark-paid.output.orderId"
                }
            },
            "next": "notify-paid",
            "model": "claude-sonnet-5-5"
        },
        {
            "key": "notify-paid",
            "kind": "output",
            "step": "payment.received-notice",
            "params": {
                "orderId": {
                    "$ref": "steps.mark-paid.output.orderId"
                }
            },
            "next": "to-after-sale",
            "model": "claude-sonnet-5-5"
        },
        {
            "key": "to-after-sale",
            "kind": "output",
            "step": "core.call-workflow",
            "params": {
                "agent": "sales",
                "workflow": "after-sale",
                "version": "latest",
                "inputs": {
                    "orderId": {
                        "$ref": "steps.mark-paid.output.orderId"
                    },
                    "leadId": {
                        "$ref": "steps.mark-paid.output.leadId"
                    }
                }
            }
        }
    ]
}
