{
    "schema": "nivo/agent-graph@1",
    "moduleKey": "chatbot",
    "contract": {
        "inputs": [
            {
                "name": "conversationId",
                "type": "string",
                "required": true
            },
            {
                "name": "text",
                "type": "string",
                "required": true
            },
            {
                "name": "channel",
                "type": "string",
                "required": true
            },
            {
                "name": "leadId",
                "type": "string",
                "required": false
            },
            {
                "name": "messages",
                "type": "array",
                "required": false
            }
        ]
    },
    "triggers": [
        {
            "key": "zalo",
            "source": {
                "kind": "zalo",
                "connectionId": null
            }
        },
        {
            "key": "telegram",
            "source": {
                "kind": "telegram",
                "connectionId": null
            }
        }
    ],
    "outcomes": [
        {
            "key": "owner",
            "label": "Chuyển chủ tiệm",
            "outputs": [
                {
                    "name": "summary",
                    "type": "string"
                }
            ]
        }
    ],
    "entry": {
        "openTo": "any"
    },
    "trigger": {
        "kind": "tag",
        "sources": [
            "channel"
        ],
        "burst": {
            "channel": {
                "window": "6s",
                "maxWait": "20s"
            }
        }
    },
    "grant": {
        "rights": [
            {
                "kind": "message",
                "access": "read",
                "scope": "turn",
                "fields": [
                    "conversationId",
                    "role",
                    "text",
                    "sentAt",
                    "status"
                ]
            },
            {
                "kind": "message",
                "access": "write",
                "scope": "turn",
                "fields": [
                    "body"
                ]
            }
        ],
        "tools": [
            "brain.search"
        ],
        "effects": [
            "agent.tag",
            "customer.message.send",
            "team.message.post"
        ]
    },
    "nodes": [
        {
            "key": "understand",
            "kind": "condition",
            "step": "chatbot.understand",
            "params": {
                "conversationId": {
                    "$ref": "trigger.conversationId"
                },
                "text": {
                    "$ref": "trigger.text"
                },
                "messages": {
                    "$ref": "trigger.messages",
                    "default": []
                },
                "lastOrderCode": {
                    "$ref": "lead.lastOrderCode",
                    "default": null
                }
            },
            "routes": {
                "buy": "to-consult",
                "paid": "to-reconcile",
                "complaint": "complaint",
                "question": "answer"
            },
            "model": "claude-sonnet-5-5"
        },
        {
            "key": "to-consult",
            "kind": "output",
            "step": "core.call-workflow",
            "params": {
                "agent": "sales",
                "workflow": "consult",
                "version": "latest",
                "inputs": {
                    "conversationId": {
                        "$ref": "trigger.conversationId"
                    },
                    "text": {
                        "$ref": "trigger.text"
                    },
                    "channel": {
                        "$ref": "trigger.channel"
                    },
                    "leadId": {
                        "$ref": "trigger.leadId",
                        "default": null
                    }
                }
            }
        },
        {
            "key": "to-reconcile",
            "kind": "output",
            "step": "core.call-workflow",
            "params": {
                "agent": "accounting",
                "workflow": "reconcile",
                "version": "latest",
                "inputs": {
                    "conversationId": {
                        "$ref": "trigger.conversationId"
                    },
                    "text": {
                        "$ref": "trigger.text"
                    },
                    "channel": {
                        "$ref": "trigger.channel"
                    },
                    "leadId": {
                        "$ref": "trigger.leadId",
                        "default": null
                    }
                }
            }
        },
        {
            "key": "complaint",
            "kind": "output",
            "step": "chatbot.complaint",
            "params": {
                "conversationId": {
                    "$ref": "trigger.conversationId"
                },
                "text": {
                    "$ref": "trigger.text"
                },
                "summary": {
                    "$ref": "steps.understand.output.summary"
                },
                "lastOrderCode": {
                    "$ref": "lead.lastOrderCode",
                    "default": null
                }
            },
            "next": "to-owner",
            "model": "claude-sonnet-5-5"
        },
        {
            "key": "to-owner",
            "kind": "output",
            "step": "core.outcome",
            "params": {
                "outcome": "owner",
                "outputs": {
                    "summary": {
                        "$ref": "steps.complaint.output.summary"
                    }
                }
            }
        },
        {
            "key": "answer",
            "kind": "output",
            "step": "chatbot.answer",
            "params": {
                "conversationId": {
                    "$ref": "trigger.conversationId"
                },
                "text": {
                    "$ref": "trigger.text"
                }
            },
            "model": "claude-sonnet-5-5"
        }
    ]
}
