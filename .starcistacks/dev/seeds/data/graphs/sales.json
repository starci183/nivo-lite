{
  "schema": "nivo/agent-graph@1",
  "moduleKey": "sales",
  "trigger": {
    "kind": "tag",
    "sources": ["channel", "chats-group", "agent", "system-event", "schedule"],
    "burst": { "agent": { "window": "0s" }, "system-event": { "window": "0s" } }
  },
  "grant": {
    "rights": [
      { "kind": "catalogue-item", "access": "read", "scope": "workspace", "fields": ["id", "name", "priceVnd", "active"] },
      { "kind": "order", "access": "read", "scope": "turn", "fields": ["id", "orderNo", "amountVnd", "status", "items"] },
      { "kind": "order", "access": "write", "scope": "turn", "fields": ["leadId", "items", "amountVnd", "status"] },
      { "kind": "message", "access": "write", "scope": "turn", "fields": ["body"] },
      { "kind": "payment-account", "access": "read", "scope": "workspace", "fields": ["bankName", "bankCode", "accountNumber", "accountHolder"] }
    ],
    "tools": ["payment.instruction"],
    "effects": ["order.record", "order.confirm", "channel.send", "work-item.raise"]
  },
  "nodes": [
    {
      "key": "record",
      "kind": "output",
      "step": "order.record",
      "input": {
        "leadId": { "$ref": "trigger.leadId" },
        "items": { "$ref": "trigger.context.items" },
        "address": { "$ref": "trigger.context.address" },
        "note": null
      },
      "next": "complete"
    },
    {
      "key": "complete",
      "kind": "condition",
      "step": "order.complete",
      "input": { "items": { "$ref": "record.items" }, "address": { "$ref": "trigger.context.address" } },
      "routes": { "missing": "ask-missing", "complete": "needs-approval" }
    },
    {
      "key": "ask-missing",
      "kind": "output",
      "step": "order.ask-missing",
      "input": {
        "conversationId": { "$ref": "trigger.conversationId" },
        "missing": { "$ref": "complete.missing" },
        "locale": "vi"
      }
    },
    {
      "key": "needs-approval",
      "kind": "condition",
      "step": "order.needs-approval",
      "params": { "thresholdVnd": 5000000 },
      "input": { "amountVnd": { "$ref": "complete.amountVnd" } },
      "routes": { "approve-self": "confirm", "awaiting-owner": "raise-approval" }
    },
    {
      "key": "confirm",
      "kind": "output",
      "step": "order.confirm",
      "input": { "orderId": { "$ref": "record.orderId" } },
      "next": "request-payment"
    },
    {
      "key": "request-payment",
      "kind": "output",
      "step": "payment.request-sepay",
      "input": {
        "orderId": { "$ref": "record.orderId" },
        "conversationId": { "$ref": "trigger.conversationId" },
        "locale": "vi"
      }
    },
    {
      "key": "raise-approval",
      "kind": "output",
      "step": "core.raise-work-item",
      "params": { "action": "confirm_order", "title": "Xác nhận đơn vượt hạn mức của bạn" },
      "input": {
        "payload": { "orderId": { "$ref": "record.orderId" } },
        "amountVnd": { "$ref": "complete.amountVnd" },
        "claimId": null
      }
    }
  ]
}
