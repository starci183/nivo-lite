{
    "schema": "nivo/agent-graph@1",
    "moduleKey": "sales",
    "contract": {
        "inputs": [
            {
                "name": "conversationId",
                "type": "string",
                "required": true
            },
            {
                "name": "text",
                "type": "string",
                "required": true
            },
            {
                "name": "channel",
                "type": "string",
                "required": false
            },
            {
                "name": "leadId",
                "type": "string",
                "required": false
            }
        ]
    },
    "triggers": [
        {
            "key": "call",
            "source": {
                "kind": "workflow",
                "connectionId": null
            }
        }
    ],
    "outcomes": [
        {
            "key": "won",
            "label": "Chốt mua",
            "outputs": [
                {
                    "name": "orderId",
                    "type": "string"
                }
            ]
        }
    ],
    "entry": {
        "openTo": "any",
        "holdsConversation": true
    },
    "trigger": {
        "kind": "tag",
        "sources": [
            "agent"
        ],
        "burst": {
            "agent": {
                "window": "0s"
            }
        }
    },
    "grant": {
        "rights": [
            {
                "kind": "order",
                "access": "read",
                "scope": "workspace",
                "fields": [
                    "id",
                    "orderNo",
                    "status",
                    "createdAt",
                    "recipientName",
                    "recipientPhone",
                    "deliveryAddress",
                    "deliveryAt",
                    "note",
                    "leadId"
                ]
            },
            {
                "kind": "catalogue-item",
                "access": "read",
                "scope": "workspace",
                "fields": [
                    "id",
                    "name",
                    "priceVnd",
                    "active",
                    "imageUrl"
                ]
            },
            {
                "kind": "message",
                "access": "read",
                "scope": "turn",
                "fields": [
                    "role",
                    "text",
                    "sentAt"
                ]
            },
            {
                "kind": "message",
                "access": "write",
                "scope": "turn",
                "fields": [
                    "body"
                ]
            },
            {
                "kind": "sales-lead",
                "access": "write",
                "scope": "turn",
                "fields": [
                    "contactName",
                    "phone",
                    "channel",
                    "stage"
                ]
            },
            {
                "kind": "order",
                "access": "write",
                "scope": "turn",
                "fields": [
                    "leadId",
                    "items",
                    "amountVnd",
                    "status"
                ]
            }
        ],
        "tools": [
            "nivo.brain.search",
            "nivo.lead.order.list"
        ],
        "effects": [
            "nivo.lead.message.send",
            "nivo.lead.ensure",
            "nivo.lead.stage.update",
            "nivo.order.create",
            "nivo.order.confirm",
            "nivo.payment.qr.create",
            "nivo.lead.care.schedule",
            "nivo.team.message.post"
        ]
    },
    "nodes": [
        {
            "key": "consult",
            "kind": "execute",
            "step": "sales.consult-turn",
            "params": {
                "conversationId": {
                    "$ref": "trigger.conversationId"
                },
                "text": {
                    "$ref": "trigger.text"
                },
                "channel": {
                    "$ref": "trigger.channel",
                    "default": null
                },
                "leadId": {
                    "$ref": "trigger.leadId",
                    "default": null
                },
                "locale": "vi",
                "address": {
                    "$ref": "lead.address",
                    "default": null
                }
            },
            "routes": {
                "ready": "create-order"
            },
            "model": "claude-sonnet-5-5"
        },
        {
            "key": "create-order",
            "kind": "output",
            "step": "sales.create-order",
            "params": {
                "conversationId": {
                    "$ref": "trigger.conversationId"
                },
                "leadId": {
                    "$ref": "steps.consult.output.leadId"
                },
                "items": {
                    "$ref": "steps.consult.output.items"
                },
                "address": {
                    "$ref": "steps.consult.output.address"
                },
                "recipientName": {
                    "$ref": "steps.consult.output.recipientName",
                    "default": null
                },
                "recipientPhone": {
                    "$ref": "steps.consult.output.recipientPhone"
                },
                "deliveryAt": {
                    "$ref": "steps.consult.output.deliveryAt"
                }
            },
            "next": "send-qr",
            "model": "claude-sonnet-5-5"
        },
        {
            "key": "send-qr",
            "kind": "output",
            "step": "payment.request",
            "params": {
                "orderId": {
                    "$ref": "steps.create-order.output.orderId"
                },
                "conversationId": {
                    "$ref": "trigger.conversationId"
                },
                "locale": "vi"
            },
            "next": "notify-order",
            "model": "claude-sonnet-5-5"
        },
        {
            "key": "notify-order",
            "kind": "output",
            "step": "sales.order-notice",
            "params": {
                "orderId": {
                    "$ref": "steps.create-order.output.orderId"
                },
                "leadId": {
                    "$ref": "steps.consult.output.leadId"
                },
                "locale": "vi"
            },
            "next": "won",
            "model": "claude-sonnet-5-5"
        },
        {
            "key": "won",
            "kind": "output",
            "step": "core.outcome",
            "params": {
                "outcome": "won",
                "outputs": {
                    "orderId": {
                        "$ref": "steps.create-order.output.orderId"
                    }
                }
            }
        }
    ]
}
