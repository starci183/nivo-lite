{
  "key": "appointment_reminder",
  "version": 2,
  "pack": "appointments",
  "executor": "implemented",
  "moduleKey": "booking",
  "icon": "calendar",
  "name": {
    "vi": "Nhắc lịch hẹn",
    "en": "Appointment reminders"
  },
  "description": {
    "vi": "NIVO đã tự nhắc khách 24 giờ và 2 giờ trước giờ hẹn. Bật thẻ này để đổi mốc giờ và lời nhắn theo cách của bạn.",
    "en": "NIVO already reminds customers 24 hours and 2 hours before. Turn this card on to change the timing and the wording."
  },
  "trigger": {
    "kind": "schedule",
    "event": "booking.upcoming",
    "line": {
      "vi": "Một khoảng thời gian trước giờ hẹn",
      "en": "A while before the appointment"
    }
  },
  "requires": {
    "modules": [
      "booking"
    ],
    "channels": [
      "customer_chat"
    ],
    "connections": [],
    "capabilities": [
      "has_appointments"
    ]
  },
  "settings": [
    {
      "key": "firstHours",
      "kind": "number",
      "min": 1,
      "max": 72,
      "suffix": {
        "vi": "giờ",
        "en": "hours"
      },
      "label": {
        "vi": "Nhắc lần 1 trước",
        "en": "First reminder before"
      }
    },
    {
      "key": "secondHours",
      "kind": "number",
      "min": 0,
      "max": 24,
      "suffix": {
        "vi": "giờ (0 = tắt)",
        "en": "hours (0 = off)"
      },
      "label": {
        "vi": "Nhắc lần 2 trước",
        "en": "Second reminder before"
      }
    }
  ],
  "contentMode": "fixed",
  "guardrails": [
    {
      "vi": "Không bịa giá, giờ, địa chỉ hay chính sách chưa có trong thông tin cửa hàng.",
      "en": "Never invent prices, hours, addresses or policies that are not in the shop information."
    }
  ],
  "variables": [
    "ten_khach",
    "ten_shop",
    "dich_vu",
    "gio_hen",
    "nguoi_lam",
    "dia_chi"
  ],
  "defaultBody": {
    "vi": "Chào {ten_khach}, {ten_shop} nhắc bạn có lịch {dich_vu} lúc {gio_hen}. Bạn nhắn lại nếu cần đổi giờ nhé.",
    "en": "Hi {ten_khach}, a reminder from {ten_shop}: {dich_vu} at {gio_hen}."
  },
  "authority": {
    "action": "remind_booking"
  },
  "defaults": {
    "firstHours": 24,
    "secondHours": 2
  }
}
