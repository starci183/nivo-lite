{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "incremental": true,
    "paths": {
      "@/*": ["./src/*"],
      "@nivo/agent-sdk": ["../../../packages/agent-sdk/src/index.ts"],
      "@nivo/agent-sdk/*": ["../../../packages/agent-sdk/src/*"],
      "@nivo/module-loyalty/*": ["../../../packages/module-loyalty/src/*"],
      "@nivo/modules/*": ["../../../packages/modules/src/*"]
    }
  },
  "include": ["next-env.d.ts", "src/**/*.ts", "src/**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
