{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "incremental": true,
    "paths": {
      "@/*": ["./src/*"],
      "@nivo-lite/agent-sdk": ["../../../packages/agent-sdk/src/index.ts"],
      "@nivo-lite/agent-sdk/*": ["../../../packages/agent-sdk/src/*"],
      "@nivo-lite/blocks-core/*": ["../../../packages/blocks-core/src/*"]
    }
  },
  "include": ["next-env.d.ts", "src/**/*.ts", "src/**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
