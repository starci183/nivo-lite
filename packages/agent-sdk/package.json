{
  "name": "@nivo/agent-sdk",
  "version": "0.1.0",
  "private": true,
  "description": "The one SDK every Nivo agent kind is built on. This branch carries the module template contract (./module), the React-free workbench contract (./workbench/contract), spec validator (./workbench/spec) and view shapes (./workbench/view) and the Grammar-only workbench blocks, host provider and spec renderer (./workbench); ./node, ./template and ./testing arrive from the marketplace branch.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./module": {
      "types": "./dist/module/index.d.ts",
      "default": "./dist/module/index.js"
    },
    "./workbench": {
      "types": "./dist/esm/workbench/index.d.ts",
      "default": "./dist/esm/workbench/index.js"
    },
    "./workbench/contract": {
      "types": "./dist/workbench/contract/index.d.ts",
      "default": "./dist/workbench/contract/index.js"
    },
    "./workbench/spec": {
      "types": "./dist/workbench/spec/index.d.ts",
      "default": "./dist/workbench/spec/index.js"
    },
    "./workbench/view": {
      "types": "./dist/workbench/view/index.d.ts",
      "default": "./dist/workbench/view/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.build.workbench.json",
    "typecheck": "tsc --noEmit --pretty false"
  },
  "peerDependencies": {
    "@starci/grammar": "0.21.11",
    "react": "19.2.3"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "typescript": "5.9.3"
  }
}
