{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "noEmit": false,
    "declaration": true,
    "isolatedDeclarations": true,
    "types": [],
    "paths": {
      "@nivo-lite/agent-sdk": ["../agent-sdk/dist/index.d.ts"],
      "@nivo-lite/agent-sdk/*": ["../agent-sdk/dist/*/index.d.ts"]
    },
    "module": "node16",
    "moduleResolution": "node16"
  },
  "exclude": ["node_modules", "dist", "src/**/*.spec.ts", "src/workbench/**"]
}
