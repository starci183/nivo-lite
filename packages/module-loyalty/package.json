{
  "name": "@nivo-lite/module-loyalty",
  "version": "0.1.0",
  "private": true,
  "description": "The Loyalty module on the Nivo agent SDK: its template (./template) and workbench declaration (./manifest), both React-free for the back end, and its Grammar-only workbench (./workbench) for the front end.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./template": {
      "types": "./dist/template/index.d.ts",
      "default": "./dist/template/index.js"
    },
    "./manifest": {
      "types": "./dist/manifest/index.d.ts",
      "default": "./dist/manifest/index.js"
    },
    "./workbench": {
      "types": "./dist/esm/workbench/index.d.ts",
      "default": "./dist/esm/workbench/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.build.workbench.json",
    "typecheck": "tsc --noEmit --pretty false"
  },
  "dependencies": {
    "@nivo-lite/agent-sdk": "*"
  },
  "peerDependencies": {
    "@starci/grammar": "0.21.33",
    "react": "19.2.3"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "typescript": "5.9.3"
  }
}
