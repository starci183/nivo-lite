{
    "id": "accounting.reconcile",
    "moduleKey": "accounting",
    "primary": true,
    "name": {
        "vi": "Đối soát tiền về",
        "en": "Reconcile incoming money"
    },
    "summary": {
        "vi": "Khớp tiền về và tin khách báo đã chuyển với đơn, đánh dấu đã trả, ghi sổ và báo đội",
        "en": "Matches money that arrives and a customer's word that they paid to the order, marks it paid, posts it and tells the team"
    },
    "requires": [
        {
            "kind": "sepay",
            "label": {
                "vi": "SePay",
                "en": "SePay"
            },
            "why": {
                "vi": "Đọc biến động số dư tài khoản ngân hàng",
                "en": "Reads the bank account feed"
            }
        },
        {
            "kind": "google",
            "label": {
                "vi": "Google Sheets",
                "en": "Google Sheets"
            },
            "why": {
                "vi": "Ghi sổ thu chi vào bảng tính",
                "en": "Writes the cash book to a sheet"
            }
        }
    ],
    "shops": 1284,
    "versions": [
        {
            "version": 5,
            "publishedAt": "2026-11-10T12:00:00.000Z",
            "changes": [
                {
                    "vi": "Một quy trình cho tiền về và khách báo đã chuyển: Khớp tiền với đơn, Đánh dấu đã trả, Ghi sổ, Báo đội và cảm ơn khách. Khớp tiền tự xét chuyển thiếu hay dư theo chính sách; tiền chưa về, tiền không thuộc đơn nào (đã hỏi chủ tiệm) hay đơn được giữ mở thì dừng lượt ở bước khớp",
                    "en": "One workflow for money arriving and a customer reporting a transfer: Match money to order, Mark paid, Post to the ledger, Tell the team and thank the customer. The match judges a short or over transfer from the policy; money not arrived yet, money for no order (the owner was asked) or an order kept open ends the turn at the match"
                }
            ],
