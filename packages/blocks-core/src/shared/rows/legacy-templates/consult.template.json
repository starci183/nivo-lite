                            "kind": "order",
                            "access": "read",
                            "scope": "workspace",
                            "fields": [
                                "id",
                                "orderNo",
                                "status",
                                "createdAt",
                                "recipientName",
                                "recipientPhone",
                                "deliveryAddress",
                                "deliveryAt",
                                "note",
                                "leadId"
                            ]
                        },
                        {
                            "kind": "catalogue-item",
                            "access": "read",
                            "scope": "workspace",
                            "fields": [
                                "id",
                                "name",
                                "priceVnd",
                                "active",
                                "imageUrl"
                            ]
                        },
                        {
                            "kind": "message",
                            "access": "read",
                            "scope": "turn",
                            "fields": [
                                "role",
                                "text",
                                "sentAt",
                                "files"
                            ]
                        },
                        {
                            "kind": "message",
                            "access": "write",
                            "scope": "turn",
                            "fields": [
                                "body"
                            ]
                        },
                        {
                            "kind": "sales-lead",
                            "access": "write",
                            "scope": "turn",
                            "fields": [
                                "contactName",
                                "phone",
                                "channel",
                                "stage",
                                "consultStage"
                            ]
                        },
                        {
                            "kind": "order",
                            "access": "write",
                            "scope": "turn",
                            "fields": [
                                "leadId",
                                "items",
                                "amountVnd",
                                "status"
                            ]
                        }
                    ],
                    "tools": [
                        "nivo.tool.brain.search",
                        "nivo.tool.brain.passage.search",
                        "nivo.tool.brain.passage.read",
                        "nivo.tool.lead.order.list"
                    ],
                    "effects": [
                        "nivo.tool.customer.message.send",
                        "nivo.tool.lead.ensure",
                        "nivo.tool.lead.update",
                        "nivo.tool.lead.stage.update",
                        "nivo.tool.order.create",
                        "nivo.tool.order.confirm",
                        "nivo.tool.order.cancel",
                        "nivo.tool.payment.transfer.create",
                        "nivo.tool.team.message.post"
                    ]
                },
                "nodes": [
                    {
                        "key": "consult",
                        "kind": "execute",
                        "step": "sales.consult-turn",
                        "params": {
                            "conversationId": {
                                "$ref": "trigger.conversationId"
                            },
                            "text": {
                                "$ref": "trigger.text"
                            },
                            "channel": {
                                "$ref": "trigger.channel",
                                "default": null
                            },
                            "leadId": {
                                "$ref": "trigger.leadId",
                                "default": null
                            },
                            "locale": "vi",
                            "address": {
                                "$ref": "lead.address",
                                "default": null
                            }
                        },
                        "routes": {
                            "ready": "create-order"
                        },
                        "accounts": [
                            {
                                "kind": "messaging",
                                "provider": null,
                                "connectionId": null,
                                "operations": {
                                    "nivo.tool.customer.message.send": "auto"
                                }
                            }
                        ]
                    },
                    {
                        "key": "create-order",
                        "kind": "output",
                        "step": "sales.create-order",
                        "params": {
                            "conversationId": {
                                "$ref": "trigger.conversationId"
                            },
                            "leadId": {
                                "$ref": "steps.consult.output.leadId"
                            },
                            "items": {
                                "$ref": "steps.consult.output.items"
                            },
                            "address": {
                                "$ref": "steps.consult.output.address"
                            },
                            "recipientName": {
                                "$ref": "steps.consult.output.recipientName",
                                "default": null
                            },
                            "recipientPhone": {
                                "$ref": "steps.consult.output.recipientPhone"
                            },
                            "deliveryAt": {
                                "$ref": "steps.consult.output.deliveryAt"
                            }
                        },
                        "next": "send-qr",
                        "accounts": [
                            {
                                "kind": "messaging",
                                "provider": null,
                                "connectionId": null,
                                "operations": {
                                    "nivo.tool.customer.message.send": "auto"
                                }
                            }
                        ]
                    },
                    {
                        "key": "send-qr",
                        "kind": "output",
                        "step": "payment.request",
                        "params": {
                            "orderId": {
                                "$ref": "steps.create-order.output.orderId"
                            },
                            "conversationId": {
                                "$ref": "trigger.conversationId"
                            },
                            "locale": "vi"
                        },
                        "next": "notify-order",
                        "accounts": [
                            {
                                "kind": "payment",
                                "provider": null,
                                "connectionId": null,
                                "operations": {
                                    "nivo.tool.payment.transfer.create": "auto"
                                }
                            },
                            {
                                "kind": "messaging",
                                "provider": null,
                                "connectionId": null,
                                "operations": {
                                    "nivo.tool.customer.message.send": "auto"
                                }
                            }
                        ]
                    },
                    {
                        "key": "notify-order",
                        "kind": "output",
                        "step": "sales.order-notice",
                        "params": {
                            "orderId": {
                                "$ref": "steps.create-order.output.orderId"
                            },
                            "leadId": {
                                "$ref": "steps.consult.output.leadId"
                            },
                            "locale": "vi"
                        },
                        "next": "won"
                    },
                    {
                        "key": "won",
                        "kind": "output",
                        "step": "core.outcome",
                        "params": {
                            "outcome": "won",
                            "outputs": {
                                "orderId": {
                                    "$ref": "steps.create-order.output.orderId"
                                }
                            }
                        }
                    }
                ]
            }
        }
    ]
}
