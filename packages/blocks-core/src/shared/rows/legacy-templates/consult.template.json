    "name": {
        "vi": "Tư vấn bán hàng",
        "en": "Sales consult"
    },
    "summary": {
        "vi": "Tư vấn, tạo đơn và gửi QR thanh toán; địa chỉ lấy từ trí nhớ khách",
        "en": "Consults, records the order and sends the payment QR; the address comes from the lead's memory"
    },
