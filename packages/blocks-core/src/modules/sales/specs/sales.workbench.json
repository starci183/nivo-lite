{
  "schema": "nivo/workbench-spec@1",
  "module": "sales",
  "params": {
    "q": {
      "type": "string",
      "url": "q",
      "default": ""
    },
    "sort": {
      "type": "enum",
      "of": "sales.leads.sort",
      "url": "sort",
      "default": "recent"
    },
    "selected": {
      "type": "string",
      "url": "lead"
    },
    "orderQ": {
      "type": "string",
      "url": "oq",
      "default": ""
    },
    "status": {
      "type": "enum",
      "of": "sales.orders.status",
      "url": "status",
      "default": "all"
    },
    "orderSort": {
      "type": "enum",
      "of": "sales.orders.sort",
      "url": "osort",
      "default": "recent"
    },
    "order": {
      "type": "string",
      "url": "order"
    },
    "pane": {
      "type": "enum",
      "of": ["list", "queue"],
      "url": "pane",
      "default": "list"
    }
  },
  "views": [
    {
      "id": "attention",
      "label": {
        "key": "tab_attention"
      },
      "root": {
        "id": "attention-root",
        "block": "core.stack",
        "props": {
          "gap": "region"
        },
        "children": [
          {
            "id": "attention-card",
            "block": "sales.attention-card",
            "props": {
              "label": {
                "key": "attention_orders"
              },
              "empty": {
                "key": "attention_empty"
              },
              "selectParam": "selected"
            },
            "bind": {
              "attention": {
                "read": "sales.attention",
                "path": "rows"
              },
              "awaitingReply": {
                "read": "sales.awaiting-reply",
                "path": "rows"
              },
              "review": {
                "action": "sales.confirm-order"
              },
              "respond": {
                "action": "sales.respond"
              },
              "follow": {
                "action": "sales.follow"
              },
              "reply": {
                "action": "sales.reply"
              },
              "parkedRuns": {
                "read": "platform.parked-runs",
                "path": "rows",
                "variables": {
                  "module": "sales"
                }
              },
              "resume": {
                "action": "platform.resume-run"
              }
            },
            "children": []
          },
          {
            "id": "recent-orders",
            "block": "core.table",
            "props": {
              "label": {
                "key": "orders"
              },
              "empty": {
                "key": "orders_empty"
              },
              "idPath": "id",
              "currency": "VND",
              "labels": {
                "status": {
                  "draft": {
                    "key": "status_draft"
                  },
                  "confirmed": {
                    "key": "status_confirmed"
                  },
                  "invoiced": {
                    "key": "status_invoiced"
                  },
                  "paid": {
                    "key": "status_paid"
                  },
                  "cancelled": {
                    "key": "status_cancelled"
                  },
                  "failed_system": {
                    "key": "status_failed_system"
                  }
                }
              },
              "pageSize": 5,
              "columns": [
                {
                  "term": {
                    "key": "col_order_no"
                  },
                  "path": "orderNo",
                  "width": "fit"
                },
                {
                  "term": {
                    "key": "col_customer"
                  },
                  "path": "customer",
                  "width": "fit"
                },
                {
                  "term": {
                    "key": "col_items"
                  },
                  "path": "itemsText",
                  "width": "fill",
                  "minWidth": 160,
                  "truncate": true,
                  "hideBelow": "desktop"
                },
                {
                  "term": {
                    "key": "col_total"
                  },
                  "path": "amountVnd",
                  "format": "money",
                  "align": "end",
                  "width": "fit"
                },
                {
                  "term": {
                    "key": "col_status"
                  },
                  "path": "status",
                  "format": "badge",
                  "width": "fit",
                  "tones": {
                    "draft": "warning",
                    "confirmed": "info",
                    "invoiced": "info",
                    "paid": "success",
                    "cancelled": "muted",
                    "failed_system": "danger"
                  }
                }
              ],
              "title": {
                "key": "recent_orders"
              }
            },
            "bind": {
              "rows": {
                "read": "sales.orders",
                "variables": {
                  "sort": "recent"
                }
              }
            }
          }
        ]
      }
    },
    {
      "id": "pipeline",
      "label": {
        "key": "tab_pipeline"
      },
      "root": {
        "id": "pipeline-root",
        "block": "core.stack",
        "props": {
          "gap": "region"
        },
        "children": [
          {
            "id": "lead-pipeline",
            "block": "sales.pipeline",
            "props": {
              "label": {
                "key": "pipeline_label"
              },
              "searchLabel": {
                "key": "pipeline_search"
              },
              "countLabel": {
                "key": "pipeline_count"
              },
              "emptyColumn": {
                "key": "board_empty_column"
              },
              "emptySearch": {
                "key": "leads_empty_search"
              },
              "selectParam": "selected",
              "searchParam": "q"
            },
            "bind": {
              "rows": {
                "read": "sales.leads",
                "variables": {
                  "q": "$q",
                  "sort": "$sort"
                }
              },
              "counts": {
                "read": "sales.lead-counts",
                "variables": {
                  "q": "$q"
                }
              },
              "move": {
                "action": "sales.move-stage"
              }
            },
            "children": []
          }
        ]
      }
    },
    {
      "id": "orders",
      "label": {
        "key": "tab_orders"
      },
      "root": {
        "id": "orders-root",
        "block": "core.stack",
        "props": {
          "gap": "region"
        },
        "children": [
          {
            "id": "orders-waiting",
            "block": "core.waiting",
            "props": {
              "label": {
                "key": "waiting_owner"
              }
            },
            "bind": {
              "region": {
                "read": "sales.orders-waiting"
              }
            }
          },
          {
            "id": "order-pane",
            "block": "core.table",
            "props": {
              "label": {
                "key": "orders"
              },
              "empty": {
                "key": "orders_empty"
              },
              "emptySearch": {
                "key": "orders_empty_search"
              },
              "idPath": "id",
              "currency": "VND",
              "labels": {
                "status": {
                  "draft": {
                    "key": "status_draft"
                  },
                  "confirmed": {
                    "key": "status_confirmed"
                  },
                  "invoiced": {
                    "key": "status_invoiced"
                  },
                  "paid": {
                    "key": "status_paid"
                  },
                  "cancelled": {
                    "key": "status_cancelled"
                  },
                  "failed_system": {
                    "key": "status_failed_system"
                  }
                }
              },
              "selectParam": "order",
              "search": true,
              "searchParam": "orderQ",
              "searchLabel": {
                "key": "search_orders"
              },
              "filterParam": "status",
              "filterLabel": {
                "key": "status_label"
              },
              "filterAll": {
                "key": "filter_all"
              },
              "filters": [
                {
                  "value": "draft",
                  "label": {
                    "key": "status_draft"
                  }
                },
                {
                  "value": "confirmed",
                  "label": {
                    "key": "status_confirmed"
                  }
                },
                {
                  "value": "invoiced",
                  "label": {
                    "key": "status_invoiced"
                  }
                },
                {
                  "value": "paid",
                  "label": {
                    "key": "status_paid"
                  }
                },
                {
                  "value": "cancelled",
                  "label": {
                    "key": "status_cancelled"
                  }
                },
                {
                  "value": "failed_system",
                  "label": {
                    "key": "status_failed_system"
                  }
                }
              ],
              "pageSize": 10,
              "columns": [
                {
                  "term": {
                    "key": "col_order_no"
                  },
                  "path": "orderNo",
                  "width": "fit"
                },
                {
                  "term": {
                    "key": "col_customer"
                  },
                  "path": "customer",
                  "width": "fit"
                },
                {
                  "term": {
                    "key": "col_items"
                  },
                  "path": "itemsText",
                  "width": "fill",
                  "minWidth": 100,
                  "truncate": true,
                  "hideBelow": "desktop"
                },
                {
                  "term": {
                    "key": "col_total"
                  },
                  "path": "amountVnd",
                  "format": "money",
                  "align": "end",
                  "width": "fit"
                },
                {
                  "term": {
                    "key": "col_status"
                  },
                  "path": "status",
                  "format": "badge",
                  "width": "fit",
                  "tones": {
                    "draft": "warning",
                    "confirmed": "info",
                    "invoiced": "info",
                    "paid": "success",
                    "cancelled": "muted",
                    "failed_system": "danger"
                  }
                },
                {
                  "term": {
                    "key": "col_date"
                  },
                  "path": "createdAt",
                  "format": "day",
                  "width": "fit",
                  "hideBelow": "tablet"
                }
              ]
            },
            "bind": {
              "rows": {
                "read": "sales.orders",
                "variables": {
                  "q": "$orderQ",
                  "status": "$status",
                  "sort": "$orderSort"
                }
              },
              "counts": {
                "read": "sales.order-counts",
                "variables": {
                  "q": "$orderQ"
                }
              }
            }
          }
        ]
      }
    },
    {
      "id": "settings",
      "label": {
        "key": "tab_settings"
      },
      "root": {
        "id": "settings-root",
        "block": "core.form",
        "props": {
          "label": {
            "key": "settings_title"
          },
          "submitLabel": {
            "key": "settings_submit"
          },
          "successNotice": {
            "key": "settings_done"
          },
          "currency": "VND",
          "fields": [
            {
              "name": "approvalThresholdVnd",
              "label": {
                "key": "settings_threshold"
              },
              "hint": {
                "key": "settings_threshold_hint"
              },
              "kind": "money"
            },
            {
              "name": "maxDiscountPct",
              "label": {
                "key": "settings_discount"
              },
              "hint": {
                "key": "settings_discount_hint"
              },
              "kind": "number"
            },
            {
              "name": "remindAfterDays",
              "label": {
                "key": "settings_remind"
              },
              "hint": {
                "key": "settings_remind_hint"
              },
              "kind": "number"
            },
            {
              "name": "autoWon",
              "label": {
                "key": "settings_auto_won"
              },
              "hint": {
                "key": "settings_auto_won_hint"
              },
              "kind": "switch"
            },
            {
              "name": "notifyAccounting",
              "label": {
                "key": "settings_notify"
              },
              "hint": {
                "key": "settings_notify_hint"
              },
              "kind": "switch"
            },
            {
              "name": "draftWithoutTotalNeedsApproval",
              "label": {
                "key": "settings_draft_without_total"
              },
              "kind": "switch",
              "hint": {
                "key": "settings_draft_without_total_hint"
              }
            },
            {
              "name": "closedDealsCanFlip",
              "label": {
                "key": "settings_closed_flip"
              },
              "kind": "switch",
              "hint": {
                "key": "settings_closed_flip_hint"
              }
            },
            {
              "name": "reopenNeedsApproval",
              "label": {
                "key": "settings_reopen"
              },
              "kind": "switch",
              "hint": {
                "key": "settings_reopen_hint"
              }
            }
          ],
          "surface": "plain"
        },
        "bind": {
          "record": {
            "read": "sales.settings"
          },
          "submit": {
            "action": "sales.save-settings"
          }
        },
        "when": {
          "permission": "sales.manage"
        }
      }
    }
  ],
  "aside": {
    "id": "aside",
    "block": "core.stack",
    "props": {
      "gap": "region"
    },
    "children": [
      {
        "id": "aside-queue",
        "block": "core.stack",
        "props": {
          "gap": "region"
        },
        "showWhen": {
          "param": "selected",
          "is": [""]
        },
        "children": [
          {
            "id": "aside-queue-orders",
            "block": "core.stack",
            "props": {
              "gap": "region"
            },
            "showWhen": {
              "param": "order",
              "is": [""]
            },
            "children": [
              {
                "id": "attention-decisions",
                "block": "core.decision-queue",
                "props": {
                  "surface": "section",
                  "label": {
                    "key": "decisions_label"
                  },
                  "emptyTitle": {
                    "key": "decisions_empty_title"
                  },
                  "emptyBody": {
                    "key": "decisions_empty_body"
                  },
                  "seeWhy": {
                    "key": "decisions_see_why"
                  },
                  "moreMenu": {
                    "key": "decisions_more"
                  },
                  "currency": "VND",
                  "commands": [
                    {
                      "id": "approve",
                      "label": {
                        "key": "command_approve"
                      }
                    },
                    {
                      "id": "reject",
                      "label": {
                        "key": "command_reject"
                      },
                      "intent": "danger"
                    }
                  ],
                  "isHeadless": true
                },
                "bind": {
                  "queue": {
                    "read": "sales.decisions"
                  },
                  "command": {
                    "action": "sales.decide"
                  }
                },
                "when": {
                  "permission": "sales.approve"
                }
              }
            ]
          }
        ]
      },
      {
        "id": "aside-lead",
        "block": "core.stack",
        "props": {
          "gap": "region"
        },
        "showWhen": {
          "param": "selected",
          "is": ["*"]
        },
        "children": [
          {
            "id": "lead-detail",
            "block": "core.detail",
            "props": {
              "label": {
                "key": "lead_detail"
              },
              "idle": {
                "key": "lead_idle_body"
              },
              "currency": "VND",
              "items": [],
              "sections": [
                {
                  "title": {
                    "key": "section_customer"
                  },
                  "items": [
                    {
                      "term": {
                        "key": "fact_company"
                      },
                      "path": "company"
                    },
                    {
                      "term": {
                        "key": "fact_stage"
                      },
                      "path": "stage",
                      "format": "badge"
                    },
                    {
                      "term": {
                        "key": "fact_channel"
                      },
                      "path": "channel"
                    },
                    {
                      "term": {
                        "key": "fact_need"
                      },
                      "path": "need"
                    }
                  ]
                },
                {
                  "title": {
                    "key": "section_contact"
                  },
                  "items": [
                    {
                      "term": {
                        "key": "fact_phone"
                      },
                      "path": "phone"
                    },
                    {
                      "term": {
                        "key": "fact_email"
                      },
                      "path": "email"
                    }
                  ]
                },
                {
                  "title": {
                    "key": "section_orders"
                  },
                  "items": [
                    {
                      "term": {
                        "key": "fact_order_count"
                      },
                      "path": "orderCount",
                      "format": "number"
                    },
                    {
                      "term": {
                        "key": "fact_confirmed"
                      },
                      "path": "confirmedVnd",
                      "format": "money"
                    },
                    {
                      "term": {
                        "key": "fact_latest_order"
                      },
                      "path": "latestOrderNo"
                    },
                    {
                      "term": {
                        "key": "fact_latest_amount"
                      },
                      "path": "latestOrderAmountVnd",
                      "format": "money"
                    }
                  ]
                },
                {
                  "title": {
                    "key": "section_outcome"
                  },
                  "items": [
                    {
                      "term": {
                        "key": "fact_closed_reason"
                      },
                      "path": "closedReason"
                    },
                    {
                      "term": {
                        "key": "fact_created"
                      },
                      "path": "createdAt",
                      "format": "dateTime"
                    }
                  ]
                }
              ],
              "labels": {
                "stage": {
                  "new": {
                    "key": "stage_new"
                  },
                  "qualified": {
                    "key": "stage_qualified"
                  },
                  "proposal": {
                    "key": "stage_proposal"
                  },
                  "won": {
                    "key": "stage_won"
                  },
                  "lost": {
                    "key": "stage_lost"
                  }
                }
              },
              "closeParam": "selected",
              "titlePath": "contactName",
              "surface": "section"
            },
            "bind": {
              "record": {
                "read": "sales.lead",
                "variables": {
                  "id": "$selected"
                }
              }
            }
          },
          {
            "id": "lead-move",
            "block": "core.form",
            "props": {
              "label": {
                "key": "move_title"
              },
              "submitLabel": {
                "key": "move_submit"
              },
              "successNotice": {
                "key": "move_done"
              },
              "fields": [
                {
                  "name": "to",
                  "label": {
                    "key": "move_to"
                  },
                  "kind": "choice",
                  "required": true,
                  "options": [
                    {
                      "value": "new",
                      "label": {
                        "key": "stage_new"
                      }
                    },
                    {
                      "value": "qualified",
                      "label": {
                        "key": "stage_qualified"
                      }
                    },
                    {
                      "value": "proposal",
                      "label": {
                        "key": "stage_proposal"
                      }
                    },
                    {
                      "value": "won",
                      "label": {
                        "key": "stage_won"
                      }
                    },
                    {
                      "value": "lost",
                      "label": {
                        "key": "stage_lost"
                      }
                    }
                  ]
                },
                {
                  "name": "reason",
                  "label": {
                    "key": "move_reason"
                  },
                  "hint": {
                    "key": "move_reason_hint"
                  },
                  "kind": "textarea",
                  "max": 500
                }
              ],
              "requireRecord": true,
              "idle": {
                "key": "lead_idle_body"
              },
              "surface": "section"
            },
            "bind": {
              "record": {
                "read": "sales.lead",
                "variables": {
                  "id": "$selected"
                }
              },
              "submit": {
                "action": "sales.move-stage"
              }
            },
            "when": {
              "permission": "sales.manage"
            }
          }
        ]
      },
      {
        "id": "aside-order",
        "block": "core.stack",
        "props": {
          "gap": "region"
        },
        "showWhen": {
          "param": "order",
          "is": ["*"]
        },
        "children": [
          {
            "id": "order-detail",
            "block": "core.detail",
            "props": {
              "primaryWhen": "canConfirm",
              "secondaryWhen": "canCancel",
              "label": {
                "key": "order_detail"
              },
              "idle": {
                "key": "order_idle_body"
              },
              "currency": "VND",
              "items": [],
              "sections": [
                {
                  "title": {
                    "key": "section_order"
                  },
                  "items": [
                    {
                      "term": {
                        "key": "fact_customer"
                      },
                      "path": "customer"
                    },
                    {
                      "term": {
                        "key": "fact_items"
                      },
                      "path": "items"
                    },
                    {
                      "term": {
                        "key": "fact_deliver"
                      },
                      "path": "deliveryAddress"
                    },
                    {
                      "term": {
                        "key": "fact_recipient_name"
                      },
                      "path": "recipientName"
                    },
                    {
                      "term": {
                        "key": "fact_recipient_phone"
                      },
                      "path": "recipientPhone"
                    },
                    {
                      "term": {
                        "key": "fact_delivery_at"
                      },
                      "path": "deliveryAt"
                    },
                    {
                      "term": {
                        "key": "fact_order_note"
                      },
                      "path": "note"
                    }
                  ]
                },
                {
                  "title": {
                    "key": "section_payment"
                  },
                  "items": [
                    {
                      "term": {
                        "key": "fact_amount"
                      },
                      "path": "amountVnd",
                      "format": "money"
                    },
                    {
                      "term": {
                        "key": "fact_status"
                      },
                      "path": "status",
                      "format": "badge"
                    }
                  ]
                },
                {
                  "title": {
                    "key": "section_history"
                  },
                  "items": [
                    {
                      "term": {
                        "key": "fact_created"
                      },
                      "path": "createdAt",
                      "format": "dateTime"
                    },
                    {
                      "term": {
                        "key": "fact_confirmed_by"
                      },
                      "path": "confirmedBy"
                    },
                    {
                      "term": {
                        "key": "fact_confirmed_at"
                      },
                      "path": "confirmedAt",
                      "format": "dateTime"
                    }
                  ]
                }
              ],
              "labels": {
                "status": {
                  "draft": {
                    "key": "status_draft"
                  },
                  "confirmed": {
                    "key": "status_confirmed"
                  },
                  "invoiced": {
                    "key": "status_invoiced"
                  },
                  "paid": {
                    "key": "status_paid"
                  },
                  "cancelled": {
                    "key": "status_cancelled"
                  },
                  "failed_system": {
                    "key": "status_failed_system"
                  }
                },
                "approval": {
                  "shop": {
                    "key": "approval_shop"
                  },
                  "owner": {
                    "key": "approval_owner"
                  },
                  "done": {
                    "key": "approval_done"
                  }
                }
              },
              "closeParam": "order",
              "titlePath": "orderNo",
              "surface": "section"
            },
            "bind": {
              "record": {
                "read": "sales.order",
                "variables": {
                  "id": "$order"
                }
              },
              "primary": {
                "action": "sales.confirm-order"
              },
              "secondary": {
                "action": "sales.cancel-order"
              }
            }
          }
        ]
      }
    ]
  },
  "asideSummary": {
    "read": "sales.decisions",
    "path": "count",
    "previewPath": "rows.0.title",
    "label": {
      "key": "aside_label"
    },
    "opens": "queue"
  }
}
