{
    "id": "sales.payment-reminder",
    "moduleKey": "sales",
    "primary": false,
    "seedActive": true,
    "name": {
        "vi": "Nhắc thanh toán",
        "en": "Payment reminder"
    },
    "summary": {
        "vi": "Nhắc khách chuyển khoản; quá 24 giờ thì báo chủ",
        "en": "Reminds the customer to pay; after 24 hours tells the owner"
    },
    "requires": [],
    "shops": 0,
    "versions": [
        {
            "version": 3,
            "publishedAt": "2026-11-10T14:00:00.000Z",
            "changes": [
                {
                    "vi": "Thuần nghiệp vụ: Đến hạn nào? 2 giờ: Nhắc khách chuyển khoản; 24 giờ: Báo đội đơn chưa trả. Giờ hẹn do công cụ gửi QR đặt",
                    "en": "Pure business steps: Which timer? 2 hours: remind the customer; 24 hours: tell the team. The QR tool arms the timers"
                },
                {
                    "vi": "Gửi bằng tin nhắn chung theo khách (leadId); bỏ quyền đọc hội thoại",
                    "en": "Sends through the one customer message by lead id; the conversation read is dropped"
                }
            ],
            "graph": {
                "schema": "nivo/agent-graph@1",
                "moduleKey": "sales",
                "contract": {
                    "inputs": [
                        {
                            "name": "careKind",
                            "type": "string",
                            "required": true
                        },
                        {
                            "name": "ref",
                            "type": "string",
                            "required": true
                        },
                        {
                            "name": "suffix",
                            "type": "string",
                            "required": false
                        },
                        {
                            "name": "dueAt",
                            "type": "string",
                            "required": false
                        }
                    ]
                },
                "triggers": [
                    {
                        "key": "timer",
                        "source": {
                            "kind": "timer",
                            "connectionId": null
                        },
                        "conditions": [
                            {
                                "param": "careKind",
                                "op": "contains",
                                "value": "payment"
                            }
                        ]
                    }
                ],
                "outcomes": [
                    {
                        "key": "reminded",
                        "label": "Đã nhắc",
                        "outputs": [
                            {
                                "name": "orderId",
                                "type": "string"
                            }
                        ]
                    },
                    {
                        "key": "timeout",
                        "label": "Hết chờ",
                        "outputs": [
                            {
                                "name": "orderId",
                                "type": "string"
                            }
                        ]
                    }
                ],
                "entry": {
                    "openTo": "agent"
                },
                "trigger": {
                    "kind": "tag",
                    "sources": [
                        "system-event"
                    ],
                    "burst": {
                        "system-event": {
                            "window": "0s"
                        }
                    }
                },
                "grant": {
                    "rights": [
                        {
                            "kind": "order",
                            "access": "read",
                            "scope": "workspace",
                            "fields": [
                                "id",
                                "orderNo",
                                "amountVnd",
                                "status",
                                "items",
                                "leadId",
                                "shippedAt",
                                "confirmedAt"
                            ]
                        },
                        {
                            "kind": "sales-lead",
                            "access": "read",
                            "scope": "workspace",
                            "fields": [
                                "id",
                                "contactName"
                            ]
                        },
                        {
                            "kind": "agent-lead-memory",
                            "access": "read",
                            "scope": "workspace",
                            "fields": [
                                "id",
                                "entryKey",
                                "output"
                            ]
                        },
                        {
                            "kind": "message",
                            "access": "write",
                            "scope": "turn",
                            "fields": [
                                "body"
                            ]
                        }
                    ],
                    "tools": [],
                    "effects": [
                        "nivo.lead.message.send",
                        "nivo.team.message.post"
                    ]
                },
                "nodes": [
                    {
                        "key": "which",
                        "kind": "condition",
                        "step": "core.if",
                        "params": {
                            "value": {
                                "$ref": "trigger.careKind"
                            },
                            "op": "equals",
                            "compare": "payment-stale"
                        },
                        "routes": {
                            "yes": "tell-team",
                            "no": "remind"
                        }
                    },
                    {
                        "key": "remind",
                        "kind": "output",
                        "step": "sales.payment-reminder",
                        "params": {
                            "orderId": {
                                "$ref": "trigger.ref"
                            },
                            "locale": "vi"
                        },
                        "next": "reminded"
                    },
                    {
                        "key": "tell-team",
                        "kind": "output",
                        "step": "sales.unpaid-notice",
                        "params": {
                            "orderId": {
                                "$ref": "trigger.ref"
                            },
                            "locale": "vi"
                        },
                        "next": "timed-out"
                    },
                    {
                        "key": "reminded",
                        "kind": "output",
                        "step": "core.outcome",
                        "params": {
                            "outcome": "reminded",
                            "outputs": {
                                "orderId": {
                                    "$ref": "trigger.ref"
                                }
                            }
                        }
                    },
                    {
                        "key": "timed-out",
                        "kind": "output",
                        "step": "core.outcome",
                        "params": {
                            "outcome": "timeout",
                            "outputs": {
                                "orderId": {
                                    "$ref": "trigger.ref"
                                }
                            }
                        }
                    }
                ]
            }
        }
    ]
}
