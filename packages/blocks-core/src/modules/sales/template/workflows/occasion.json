{
    "id": "sales.occasion",
    "moduleKey": "sales",
    "primary": false,
    "seedActive": true,
    "name": {
        "vi": "Nhắc dịp đặc biệt",
        "en": "Occasion reminder"
    },
    "summary": {
        "vi": "Nhắc khách trước dịp họ đã kể",
        "en": "Reminds the customer before an occasion they mentioned"
    },
    "requires": [],
    "shops": 0,
    "versions": [
        {
            "version": 4,
            "publishedAt": "2026-11-12T00:00:00.000Z",
            "changes": [
                {
                    "vi": "Chạy ngay từ lịch hẹn: bước gợi ý nhận thời điểm hẹn của lượt chạy và gửi luôn khi chủ tiệm bấm Chạy ngay",
                    "en": "Run now from the schedule: the suggest step takes the run's due moment and writes at once when the owner presses Run now"
                },
                {
                    "vi": "Thuần nghiệp vụ: Gợi ý đặt lại cho dịp (AI tự viết), Đã chúc",
                    "en": "Pure business steps: Suggest a reorder for the date (the AI writes it), Greeted"
                },
                {
                    "vi": "Gửi bằng tin nhắn chung theo khách (leadId); bỏ quyền đọc hội thoại",
                    "en": "Sends through the one customer message by lead id; the conversation read is dropped"
                }
            ],
            "graph": {
                "schema": "nivo/agent-graph@1",
                "moduleKey": "sales",
                "contract": {
                    "inputs": [
                        {
                            "name": "careKind",
                            "type": "string",
                            "required": true
                        },
                        {
                            "name": "ref",
                            "type": "string",
                            "required": true
                        },
                        {
                            "name": "suffix",
                            "type": "string",
                            "required": false
                        },
                        {
                            "name": "dueAt",
                            "type": "string",
                            "required": false
                        }
                    ]
                },
                "triggers": [
                    {
                        "key": "timer",
                        "source": {
                            "kind": "timer",
                            "connectionId": null
                        },
                        "conditions": [
                            {
                                "param": "careKind",
                                "op": "equals",
                                "value": "occasion"
                            }
                        ]
                    }
                ],
                "outcomes": [
                    {
                        "key": "greeted",
                        "label": "Đã chúc",
                        "outputs": [
                            {
                                "name": "leadId",
                                "type": "string"
                            }
                        ]
                    }
                ],
                "entry": {
                    "openTo": "agent"
                },
                "trigger": {
                    "kind": "tag",
                    "sources": [
                        "system-event"
                    ],
                    "burst": {
                        "system-event": {
                            "window": "0s"
                        }
                    }
                },
                "grant": {
                    "rights": [
                        {
                            "kind": "order",
                            "access": "read",
                            "scope": "workspace",
                            "fields": [
                                "id",
                                "orderNo",
                                "amountVnd",
                                "status",
                                "items",
                                "leadId",
                                "shippedAt",
                                "confirmedAt"
                            ]
                        },
                        {
                            "kind": "sales-lead",
                            "access": "read",
                            "scope": "workspace",
                            "fields": [
                                "id",
                                "contactName"
                            ]
                        },
                        {
                            "kind": "agent-lead-memory",
                            "access": "read",
                            "scope": "workspace",
                            "fields": [
                                "id",
                                "entryKey",
                                "output"
                            ]
                        },
                        {
                            "kind": "message",
                            "access": "write",
                            "scope": "turn",
                            "fields": [
                                "body"
                            ]
                        }
                    ],
                    "tools": [],
                    "effects": [
                        "customer.message.send",
                        "customer.care.schedule"
                    ]
                },
                "nodes": [
                    {
                        "key": "suggest",
                        "kind": "output",
                        "step": "sales.care-occasion",
                        "params": {
                            "occasionLeadDays": 7,
                            "leadId": {
                                "$ref": "trigger.ref"
                            },
                            "suffix": {
                                "$ref": "trigger.suffix",
                                "default": null
                            },
                            "dueAt": {
                                "$ref": "trigger.dueAt",
                                "default": null
                            },
                            "locale": "vi"
                        },
                        "next": "greeted"
                    },
                    {
                        "key": "greeted",
                        "kind": "output",
                        "step": "core.outcome",
                        "params": {
                            "outcome": "greeted",
                            "outputs": {
                                "leadId": {
                                    "$ref": "trigger.ref"
                                }
                            }
                        }
                    }
                ]
            }
        }
    ]
}
