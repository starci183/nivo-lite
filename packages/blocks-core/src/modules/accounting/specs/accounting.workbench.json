{
  "schema": "nivo/workbench-spec@1",
  "module": "accounting",
  "params": {
    "q": {
      "type": "string",
      "url": "q",
      "default": ""
    },
    "sort": {
      "type": "enum",
      "of": "accounting.entries.sort",
      "url": "sort",
      "default": "recent"
    },
    "selected": {
      "type": "string",
      "url": "entry"
    },
    "period": {
      "type": "enum",
      "of": ["this", "last"],
      "url": "period",
      "default": "this"
    },
    "status": {
      "type": "enum",
      "of": "accounting.entries.status",
      "url": "status",
      "default": "all"
    },
    "pane": {
      "type": "enum",
      "of": ["list", "queue"],
      "url": "pane",
      "default": "list"
    }
  },
  "views": [
    {
      "id": "overview",
      "label": {
        "key": "tab_overview"
      },
      "root": {
        "id": "overview-root",
        "block": "core.stack",
        "props": {
          "gap": "region"
        },
        "children": [
          {
            "id": "figures",
            "block": "core.figures",
            "props": {
              "label": {
                "key": "figures"
              },
              "items": [
                {
                  "term": {
                    "key": "fig_income"
                  },
                  "path": "income.vnd",
                  "format": "money"
                },
                {
                  "term": {
                    "key": "fig_invoiced"
                  },
                  "path": "invoiced.vnd",
                  "format": "money"
                },
                {
                  "term": {
                    "key": "fig_adjustments"
                  },
                  "path": "adjustments.vnd",
                  "format": "money"
                },
                {
                  "term": {
                    "key": "fig_unmatched"
                  },
                  "path": "unmatched.vnd",
                  "format": "money"
                },
                {
                  "term": {
                    "key": "fig_receivable"
                  },
                  "path": "receivable.vnd",
                  "format": "money"
                }
              ],
              "currency": "VND"
            },
            "bind": {
              "data": {
                "read": "accounting.figures",
                "variables": {
                  "period": "$period"
                }
              }
            },
            "when": {
              "permission": "accounting.view"
            },
            "children": []
          },
          {
            "id": "weekly",
            "block": "core.figures",
            "props": {
              "label": {
                "key": "weekly_label"
              },
              "kind": "bars",
              "currency": "VND",
              "items": [
                {
                  "term": {
                    "key": "week_w1"
                  },
                  "path": "w1",
                  "format": "money"
                },
                {
                  "term": {
                    "key": "week_w2"
                  },
                  "path": "w2",
                  "format": "money"
                },
                {
                  "term": {
                    "key": "week_w3"
                  },
                  "path": "w3",
                  "format": "money"
                },
                {
                  "term": {
                    "key": "week_w4"
                  },
                  "path": "w4",
                  "format": "money"
                },
                {
                  "term": {
                    "key": "week_w5"
                  },
                  "path": "w5",
                  "format": "money"
                }
              ]
            },
            "bind": {
              "data": {
                "read": "accounting.weekly",
                "variables": {
                  "period": "$period"
                }
              }
            },
            "children": []
          },
          {
            "id": "ageing",
            "block": "core.figures",
            "props": {
              "label": {
                "key": "ageing_label"
              },
              "kind": "proportion",
              "currency": "VND",
              "items": [
                {
                  "term": {
                    "key": "ageing_d0"
                  },
                  "path": "ageing.d0.count",
                  "format": "count"
                },
                {
                  "term": {
                    "key": "ageing_d30"
                  },
                  "path": "ageing.d30.count",
                  "format": "count"
                },
                {
                  "term": {
                    "key": "ageing_d60"
                  },
                  "path": "ageing.d60.count",
                  "format": "count"
                }
              ]
            },
            "bind": {
              "data": {
                "read": "accounting.figures",
                "variables": {
                  "period": "$period"
                }
              }
            },
            "children": []
          }
        ]
      }
    },
    {
      "id": "book",
      "label": {
        "key": "tab_book"
      },
      "root": {
        "id": "root",
        "block": "core.master-detail",
        "props": {
          "emptyTitle": {
            "key": "entry_empty_title"
          },
          "emptyBody": {
            "key": "entry_empty_body"
          }
        },
        "children": [
          {
            "id": "pane",
            "block": "core.list-pane",
            "props": {
              "search": true,
              "searchParam": "q",
              "searchLabel": {
                "key": "search"
              }
            },
            "children": [
              {
                "id": "tabs",
                "block": "core.filter-tabs",
                "props": {
                  "param": "status",
                  "all": {
                    "key": "filter_all"
                  },
                  "items": [
                    {
                      "value": "paid",
                      "label": {
                        "key": "tab_paid"
                      }
                    },
                    {
                      "value": "open",
                      "label": {
                        "key": "tab_open"
                      }
                    },
                    {
                      "value": "expense",
                      "label": {
                        "key": "tab_expense"
                      }
                    },
                    {
                      "value": "review",
                      "label": {
                        "key": "tab_review"
                      }
                    }
                  ]
                },
                "bind": {
                  "counts": {
                    "read": "accounting.status-counts",
                    "variables": {
                      "q": "$q"
                    }
                  }
                }
              },
              {
                "id": "rows",
                "block": "core.table",
                "props": {
                  "label": {
                    "key": "entries"
                  },
                  "empty": {
                    "key": "entries_empty"
                  },
                  "idPath": "id",
                  "currency": "VND",
                  "labels": {
                    "status": {
                      "paid": {
                        "key": "status_paid"
                      },
                      "open": {
                        "key": "status_open"
                      },
                      "expense": {
                        "key": "status_expense"
                      },
                      "review": {
                        "key": "status_review"
                      }
                    }
                  },
                  "selectParam": "selected",
                  "columns": [
                    {
                      "term": {
                        "key": "col_date"
                      },
                      "path": "entryDate",
                      "format": "date"
                    },
                    {
                      "term": {
                        "key": "col_entry"
                      },
                      "path": "title"
                    },
                    {
                      "term": {
                        "key": "col_amount"
                      },
                      "path": "amountVnd",
                      "format": "money",
                      "align": "end"
                    },
                    {
                      "term": {
                        "key": "col_status"
                      },
                      "path": "status",
                      "format": "badge"
                    }
                  ],
                  "tones": {
                    "paid": "success",
                    "open": "warning",
                    "expense": "neutral",
                    "review": "danger"
                  }
                },
                "bind": {
                  "rows": {
                    "read": "accounting.entries",
                    "variables": {
                      "q": "$q",
                      "status": "$status",
                      "sort": "$sort"
                    }
                  }
                }
              }
            ]
          },
          {
            "id": "side",
            "block": "core.stack",
            "props": {
              "gap": "section"
            },
            "children": [
              {
                "id": "detail",
                "block": "core.detail",
                "props": {
                  "label": {
                    "key": "entry"
                  },
                  "idle": {
                    "key": "entry_idle"
                  },
                  "idPath": "id",
                  "currency": "VND",
                  "items": [
                    {
                      "term": {
                        "key": "fact_date"
                      },
                      "path": "entryDate",
                      "format": "date"
                    },
                    {
                      "term": {
                        "key": "fact_kind"
                      },
                      "path": "kind",
                      "format": "badge"
                    },
                    {
                      "term": {
                        "key": "fact_amount"
                      },
                      "path": "amountVnd",
                      "format": "money"
                    },
                    {
                      "term": {
                        "key": "fact_note"
                      },
                      "path": "note",
                      "format": "text"
                    },
                    {
                      "term": {
                        "key": "fact_source"
                      },
                      "path": "sourceEntity",
                      "format": "text"
                    }
                  ],
                  "labels": {
                    "kind": {
                      "income": {
                        "key": "kind_income"
                      },
                      "expense": {
                        "key": "kind_expense"
                      },
                      "invoice": {
                        "key": "kind_invoice"
                      },
                      "reversal": {
                        "key": "kind_reversal"
                      },
                      "adjustment": {
                        "key": "kind_adjustment"
                      }
                    }
                  }
                },
                "bind": {
                  "record": {
                    "read": "accounting.entry",
                    "variables": {
                      "id": "$selected"
                    }
                  }
                }
              },
              {
                "id": "lineage",
                "block": "core.record-list",
                "props": {
                  "label": {
                    "key": "lineage"
                  },
                  "empty": {
                    "key": "lineage_empty"
                  },
                  "idPath": "id",
                  "titlePath": "title",
                  "descriptionPath": "detail",
                  "badgePath": "kind",
                  "labels": {
                    "kind": {
                      "income": {
                        "key": "kind_income"
                      },
                      "expense": {
                        "key": "kind_expense"
                      },
                      "invoice": {
                        "key": "kind_invoice"
                      },
                      "reversal": {
                        "key": "kind_reversal"
                      },
                      "adjustment": {
                        "key": "kind_adjustment"
                      }
                    }
                  }
                },
                "bind": {
                  "rows": {
                    "read": "accounting.entry",
                    "path": "lineage",
                    "variables": {
                      "id": "$selected"
                    }
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "settings",
      "label": {
        "key": "tab_settings"
      },
      "root": {
        "id": "settings-root",
        "block": "core.form",
        "props": {
          "label": {
            "key": "settings_title"
          },
          "submitLabel": {
            "key": "settings_submit"
          },
          "successNotice": {
            "key": "settings_done"
          },
          "fields": [
            {
              "name": "postExpenses",
              "label": {
                "key": "settings_post_expenses"
              },
              "kind": "switch"
            },
            {
              "name": "postOutgoing",
              "label": {
                "key": "settings_post_outgoing"
              },
              "kind": "switch"
            },
            {
              "name": "postUnmatched",
              "label": {
                "key": "settings_post_unmatched"
              },
              "kind": "switch"
            },
            {
              "name": "voidMode",
              "label": {
                "key": "settings_void_mode"
              },
              "kind": "choice",
              "options": [
                {
                  "value": "reversal",
                  "label": {
                    "key": "void_reversal"
                  }
                },
                {
                  "value": "none",
                  "label": {
                    "key": "void_none"
                  }
                }
              ]
            }
          ]
        },
        "bind": {
          "record": {
            "read": "accounting.settings"
          },
          "submit": {
            "action": "accounting.save-settings"
          }
        },
        "when": {
          "permission": "accounting.manage"
        }
      }
    }
  ],
  "aside": {
    "id": "decisions",
    "block": "core.decision-queue",
    "props": {
      "surface": "section",
      "label": {
        "key": "decisions_label"
      },
      "emptyTitle": {
        "key": "decisions_empty_title"
      },
      "emptyBody": {
        "key": "decisions_empty_body"
      },
      "seeWhy": {
        "key": "decisions_see_why"
      },
      "moreMenu": {
        "key": "decisions_more"
      },
      "currency": "VND"
    },
    "bind": {
      "queue": {
        "read": "accounting.decisions"
      }
    }
  },
  "asideSummary": {
    "read": "accounting.decisions",
    "path": "count",
    "previewPath": "rows.0.title",
    "label": {
      "key": "aside_label"
    },
    "opens": "queue"
  }
}
