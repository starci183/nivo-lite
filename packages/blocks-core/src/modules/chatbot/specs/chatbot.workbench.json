{
  "schema": "nivo/workbench-spec@1",
  "module": "chatbot",
  "params": {
    "q": {
      "type": "string",
      "url": "q"
    },
    "status": {
      "type": "enum",
      "of": "chatbot.threads.status",
      "url": "status",
      "default": "all"
    },
    "selected": {
      "type": "string",
      "url": "thread"
    },
    "pane": {
      "type": "enum",
      "of": ["list", "queue"],
      "url": "pane",
      "default": "list"
    }
  },
  "views": [
    {
      "id": "customers",
      "label": {
        "key": "tab_customers"
      },
      "root": {
        "id": "customers-page",
        "block": "core.stack",
        "props": {
          "gap": "region"
        },
        "children": [
          {
            "id": "figures",
            "block": "core.figures",
            "props": {
              "label": {
                "key": "figures_label"
              },
              "items": [
                {
                  "term": {
                    "key": "fig_total"
                  },
                  "path": "total",
                  "format": "count"
                },
                {
                  "term": {
                    "key": "fig_ai_share"
                  },
                  "path": "aiShare",
                  "format": "percent"
                },
                {
                  "term": {
                    "key": "fig_needs"
                  },
                  "path": "needsCount",
                  "format": "count"
                },
                {
                  "term": {
                    "key": "fig_handled"
                  },
                  "path": "handledCount",
                  "format": "count"
                }
              ]
            },
            "bind": {
              "data": {
                "read": "chatbot.figures"
              }
            }
          },
          {
            "id": "customers-section",
            "block": "core.section",
            "props": {
              "title": {
                "key": "customers_section"
              }
            },
            "children": [
              {
                "id": "pane",
                "block": "core.list-pane",
                "props": {
                  "search": true,
                  "searchParam": "q",
                  "searchLabel": {
                    "key": "search_label"
                  }
                },
                "children": [
                  {
                    "id": "statuses",
                    "block": "core.filter-tabs",
                    "props": {
                      "param": "status",
                      "label": {
                        "key": "status_filter_label"
                      },
                      "all": {
                        "key": "filter_all"
                      },
                      "items": [
                        {
                          "value": "needs",
                          "label": {
                            "key": "status_needs"
                          },
                          "attention": true
                        },
                        {
                          "value": "handled",
                          "label": {
                            "key": "status_handled"
                          }
                        },
                        {
                          "value": "today",
                          "label": {
                            "key": "inbox_tab_today"
                          }
                        }
                      ]
                    },
                    "bind": {
                      "counts": {
                        "read": "chatbot.thread-counts",
                        "variables": {
                          "q": "$q"
                        }
                      }
                    }
                  },
                  {
                    "id": "threads",
                    "block": "core.record-list",
                    "props": {
                      "label": {
                        "key": "list_label"
                      },
                      "empty": {
                        "key": "list_empty"
                      },
                      "emptySearch": {
                        "key": "list_empty_search"
                      },
                      "idPath": "id",
                      "titlePath": "name",
                      "descriptionPath": "lastText",
                      "selectParam": "selected",
                      "searchParam": "q",
                      "badgePath": "status",
                      "labels": {
                        "status": {
                          "needs": {
                            "key": "row_needs"
                          },
                          "handled": {
                            "key": "row_handled"
                          },
                          "ai": {
                            "key": "row_ai"
                          }
                        },
                        "channel": {
                          "zalo": {
                            "key": "channel_zalo"
                          },
                          "telegram": {
                            "key": "channel_telegram"
                          },
                          "facebook": {
                            "key": "channel_facebook"
                          },
                          "instagram": {
                            "key": "channel_instagram"
                          },
                          "website": {
                            "key": "channel_website"
                          }
                        }
                      },
                      "avatar": true,
                      "chipPaths": ["channel"],
                      "badgeTones": {
                        "needs": "warning",
                        "handled": "info",
                        "ai": "neutral"
                      }
                    },
                    "bind": {
                      "rows": {
                        "read": "chatbot.threads",
                        "variables": {
                          "q": "$q",
                          "status": "$status"
                        }
                      }
                    }
                  }
                ],
                "bind": {}
              }
            ]
          }
        ]
      }
    },
    {
      "id": "unanswered",
      "label": {
        "key": "tab_unanswered"
      },
      "root": {
        "id": "unanswered-page",
        "block": "core.section",
        "props": {
          "title": {
            "key": "unanswered_section"
          }
        },
        "children": [
          {
            "id": "waiting-threads",
            "block": "core.record-list",
            "props": {
              "label": {
                "key": "list_label"
              },
              "empty": {
                "key": "list_empty"
              },
              "emptySearch": {
                "key": "list_empty_search"
              },
              "idPath": "id",
              "titlePath": "name",
              "descriptionPath": "lastText",
              "badgePath": "status",
              "labels": {
                "status": {
                  "needs": {
                    "key": "row_needs"
                  },
                  "handled": {
                    "key": "row_handled"
                  },
                  "ai": {
                    "key": "row_ai"
                  }
                },
                "channel": {
                  "zalo": {
                    "key": "channel_zalo"
                  },
                  "telegram": {
                    "key": "channel_telegram"
                  },
                  "facebook": {
                    "key": "channel_facebook"
                  },
                  "instagram": {
                    "key": "channel_instagram"
                  },
                  "website": {
                    "key": "channel_website"
                  }
                }
              },
              "avatar": true,
              "chipPaths": ["channel"],
              "badgeTones": {
                "needs": "warning",
                "handled": "info",
                "ai": "neutral"
              }
            },
            "bind": {
              "rows": {
                "read": "chatbot.threads",
                "variables": {
                  "q": "$q",
                  "status": "needs"
                }
              }
            }
          }
        ]
      }
    },
    {
      "id": "inbox",
      "label": {
        "key": "tab_inbox"
      },
      "root": {
        "id": "inbox",
        "block": "chatbot.inbox",
        "props": {
          "searchParam": "q",
          "statusParam": "status",
          "selectParam": "selected"
        },
        "bind": {
          "threads": {
            "read": "chatbot.threads",
            "variables": {
              "q": "$q",
              "status": "$status"
            }
          },
          "counts": {
            "read": "chatbot.thread-counts",
            "variables": {
              "q": "$q"
            }
          },
          "messages": {
            "read": "chatbot.messages",
            "path": "rows",
            "variables": {
              "threadId": "$selected"
            }
          },
          "thread": {
            "read": "chatbot.thread",
            "variables": {
              "id": "$selected"
            }
          },
          "send": {
            "action": "chatbot.reply"
          },
          "handoff": {
            "action": "chatbot.handoff"
          },
          "release": {
            "action": "chatbot.release"
          }
        },
        "children": [
          {
            "id": "approval",
            "block": "chatbot.approval-card",
            "props": {},
            "bind": {
              "proposal": {
                "read": "chatbot.proposals",
                "variables": {
                  "threadId": "$selected"
                }
              },
              "approve": {
                "action": "chatbot.approve-and-send"
              },
              "dismiss": {
                "action": "chatbot.reject-proposal"
              }
            }
          }
        ]
      }
    },
    {
      "id": "rules",
      "label": {
        "key": "tab_rules"
      },
      "root": {
        "id": "rules-root",
        "block": "chatbot.rules",
        "props": {},
        "bind": {
          "settings": {
            "read": "chatbot.settings"
          },
          "save": {
            "action": "chatbot.save-settings"
          }
        }
      }
    }
  ],
  "aside": {
    "id": "decisions",
    "block": "core.decision-queue",
    "props": {
      "surface": "section",
      "label": {
        "key": "decisions_label"
      },
      "emptyTitle": {
        "key": "decisions_empty_title"
      },
      "emptyBody": {
        "key": "decisions_empty_body"
      },
      "seeWhy": {
        "key": "decisions_see_why"
      },
      "moreMenu": {
        "key": "decisions_more"
      },
      "commands": [
        {
          "id": "handoff",
          "label": {
            "key": "action_handoff"
          }
        }
      ],
      "isHeadless": true
    },
    "bind": {
      "queue": {
        "read": "chatbot.decisions"
      },
      "command": {
        "action": "chatbot.decide"
      }
    }
  },
  "asideSummary": {
    "read": "chatbot.decisions",
    "path": "count",
    "previewPath": "rows.0.title",
    "label": {
      "key": "aside_label"
    },
    "opens": "queue"
  }
}
