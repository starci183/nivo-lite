{
  "schema": "nivo/workbench-spec@1",
  "module": "chatbot",
  "params": {
    "q": {
      "type": "string",
      "url": "q"
    },
    "status": {
      "type": "enum",
      "of": "chatbot.threads.status",
      "url": "status",
      "default": "all"
    },
    "selected": {
      "type": "string",
      "url": "thread"
    }
  },
  "views": [
    {
      "id": "inbox",
      "label": {
        "key": "tab_inbox"
      },
      "root": {
        "id": "inbox-page",
        "block": "core.stack",
        "props": {
          "gap": "region"
        },
        "children": [
          {
            "id": "figures",
            "block": "core.figures",
            "props": {
              "label": {
                "key": "figures_label"
              },
              "items": [
                {
                  "term": {
                    "key": "fig_total"
                  },
                  "path": "total",
                  "format": "count"
                },
                {
                  "term": {
                    "key": "fig_ai_share"
                  },
                  "path": "aiShare",
                  "format": "percent"
                },
                {
                  "term": {
                    "key": "fig_needs"
                  },
                  "path": "needsCount",
                  "format": "count"
                },
                {
                  "term": {
                    "key": "fig_handled"
                  },
                  "path": "handledCount",
                  "format": "count"
                }
              ]
            },
            "bind": {
              "data": {
                "read": "chatbot.figures"
              }
            }
          },
          {
            "id": "decisions",
            "block": "core.decision-queue",
            "props": {
              "surface": "section",
              "label": {
                "key": "decisions_label"
              },
              "emptyTitle": {
                "key": "decisions_empty_title"
              },
              "emptyBody": {
                "key": "decisions_empty_body"
              },
              "seeWhy": {
                "key": "decisions_see_why"
              },
              "moreMenu": {
                "key": "decisions_more"
              },
              "commands": [
                {
                  "id": "handoff",
                  "label": {
                    "key": "action_handoff"
                  }
                }
              ]
            },
            "bind": {
              "queue": {
                "read": "chatbot.decisions"
              },
              "command": {
                "action": "chatbot.decide"
              }
            }
          },
          {
            "id": "inbox",
            "block": "core.master-detail",
            "props": {
              "emptyTitle": {
                "key": "master_empty_title"
              },
              "emptyBody": {
                "key": "master_empty_body"
              }
            },
            "children": [
              {
                "id": "pane",
                "block": "core.list-pane",
                "props": {
                  "search": true,
                  "searchParam": "q",
                  "searchLabel": {
                    "key": "search_label"
                  }
                },
                "children": [
                  {
                    "id": "statuses",
                    "block": "core.filter-tabs",
                    "props": {
                      "param": "status",
                      "label": {
                        "key": "status_filter_label"
                      },
                      "all": {
                        "key": "filter_all"
                      },
                      "items": [
                        {
                          "value": "needs",
                          "label": {
                            "key": "status_needs"
                          },
                          "attention": true
                        },
                        {
                          "value": "handled",
                          "label": {
                            "key": "status_handled"
                          }
                        },
                        {
                          "value": "ai",
                          "label": {
                            "key": "status_ai"
                          }
                        }
                      ]
                    },
                    "bind": {
                      "counts": {
                        "read": "chatbot.thread-counts",
                        "variables": {
                          "q": "$q"
                        }
                      }
                    }
                  },
                  {
                    "id": "threads",
                    "block": "core.record-list",
                    "props": {
                      "label": {
                        "key": "list_label"
                      },
                      "empty": {
                        "key": "list_empty"
                      },
                      "emptySearch": {
                        "key": "list_empty_search"
                      },
                      "idPath": "id",
                      "titlePath": "name",
                      "descriptionPath": "lastText",
                      "selectParam": "selected",
                      "searchParam": "q",
                      "badgePath": "status",
                      "labels": {
                        "status": {
                          "needs": {
                            "key": "row_needs"
                          },
                          "handled": {
                            "key": "row_handled"
                          },
                          "ai": {
                            "key": "row_ai"
                          }
                        }
                      }
                    },
                    "bind": {
                      "rows": {
                        "read": "chatbot.threads",
                        "path": "rows",
                        "variables": {
                          "q": "$q",
                          "status": "$status"
                        }
                      }
                    }
                  }
                ],
                "bind": {}
              },
              {
                "id": "thread-side",
                "block": "core.aside-detail",
                "props": {
                  "width": "medium"
                },
                "children": [
                  {
                    "id": "thread",
                    "block": "core.conversation",
                    "props": {
                      "label": {
                        "key": "thread_label"
                      },
                      "empty": {
                        "key": "thread_empty"
                      },
                      "pick": {
                        "key": "thread_pick"
                      },
                      "idPath": "id",
                      "textPath": "text",
                      "authorPath": "who",
                      "timePath": "at",
                      "statusPath": "state",
                      "sidePath": "side",
                      "markPath": "mark",
                      "composer": true,
                      "selectParam": "selected",
                      "maxLength": 4000
                    },
                    "bind": {
                      "messages": {
                        "read": "chatbot.messages",
                        "path": "rows",
                        "variables": {
                          "threadId": "$selected"
                        }
                      },
                      "send": {
                        "action": "chatbot.reply"
                      },
                      "handoff": {
                        "action": "chatbot.handoff"
                      }
                    }
                  },
                  {
                    "id": "customer",
                    "block": "core.detail",
                    "props": {
                      "label": {
                        "key": "customer_label"
                      },
                      "idle": {
                        "key": "customer_idle"
                      },
                      "idPath": "id",
                      "items": [
                        {
                          "term": {
                            "key": "fact_name"
                          },
                          "path": "name"
                        },
                        {
                          "term": {
                            "key": "fact_channel"
                          },
                          "path": "channelName"
                        },
                        {
                          "term": {
                            "key": "fact_handled_by"
                          },
                          "path": "handledBy"
                        },
                        {
                          "term": {
                            "key": "fact_stage"
                          },
                          "path": "stage"
                        },
                        {
                          "term": {
                            "key": "fact_need"
                          },
                          "path": "need"
                        },
                        {
                          "term": {
                            "key": "fact_company"
                          },
                          "path": "company"
                        },
                        {
                          "term": {
                            "key": "fact_phone"
                          },
                          "path": "phone"
                        },
                        {
                          "term": {
                            "key": "fact_email"
                          },
                          "path": "email"
                        }
                      ],
                      "labels": {
                        "stage": {
                          "new": {
                            "key": "stage_new"
                          },
                          "qualified": {
                            "key": "stage_qualified"
                          },
                          "proposal": {
                            "key": "stage_proposal"
                          },
                          "won": {
                            "key": "stage_won"
                          },
                          "lost": {
                            "key": "stage_lost"
                          }
                        }
                      }
                    },
                    "bind": {
                      "record": {
                        "read": "chatbot.thread",
                        "variables": {
                          "id": "$selected"
                        }
                      },
                      "primary": {
                        "action": "chatbot.handoff"
                      },
                      "secondary": {
                        "action": "chatbot.release"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    }
  ]
}
