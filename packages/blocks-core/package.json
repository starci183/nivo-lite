{
  "name": "@nivo-lite/blocks-core",
  "version": "0.1.0",
  "private": true,
  "description": "All of Nivo's business on the agent SDK: the generic blocks and graph nodes, each module's declaration and template (./modules/<module>) and the registry that lists them (./modules), every one made with defineBlock, defineNode or the module types of @nivo-lite/agent-sdk. The root export and ./modules are React-free for the back end; ./client holds the Grammar-only block components.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./entities": {
      "types": "./dist/shared/entities/index.d.ts",
      "default": "./dist/shared/entities/index.js"
    },
    "./rules/chatbot": {
      "types": "./dist/agents/chatbot/rules/index.d.ts",
      "default": "./dist/agents/chatbot/rules/index.js"
    },
    "./graph": {
      "types": "./dist/shared/graph-cards.d.ts",
      "default": "./dist/shared/graph-cards.js"
    },
    "./modules": {
      "types": "./dist/shared/modules/index.d.ts",
      "default": "./dist/shared/modules/index.js"
    },
    "./modules/sales/ledger": {
      "types": "./dist/agents/sales/ledger/index.d.ts",
      "default": "./dist/agents/sales/ledger/index.js"
    },
    "./modules/sales": {
      "types": "./dist/agents/sales/index.d.ts",
      "default": "./dist/agents/sales/index.js"
    },
    "./rules/sales": {
      "types": "./dist/agents/sales/rules/index.d.ts",
      "default": "./dist/agents/sales/rules/index.js"
    },
    "./messages/vi.json": "./dist/esm/shared/messages/vi.json",
    "./messages/en.json": "./dist/esm/shared/messages/en.json",
    "./fixtures": {
      "types": "./dist/shared/fixtures.d.ts",
      "default": "./dist/shared/fixtures.js"
    },
    "./client": {
      "types": "./dist/esm/shared/client/index.d.ts",
      "default": "./dist/esm/shared/client/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.build.client.json",
    "typecheck": "tsc --noEmit --pretty false"
  },
  "peerDependencies": {
    "@heroicons/react": "2.2.0",
    "@heroui/react": "3.2.6",
    "@nivo-lite/agent-sdk": "*",
    "@starci/common": "1.0.1",
    "@starci/grammar": "0.39.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nivo-lite/agent-sdk": "*",
    "@starci/common": "1.0.1",
    "@types/react": "19.3.0",
    "typescript": "5.9.3"
  }
}
