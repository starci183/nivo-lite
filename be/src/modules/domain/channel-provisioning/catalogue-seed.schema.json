{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NIVO workspace catalogue seed",
  "type": "object",
  "required": ["schema", "items"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "nivo/catalogue-seed@1" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["sku", "name", "unit", "sellPriceVnd"],
        "additionalProperties": false,
        "properties": {
          "sku": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9-]{0,39}$" },
          "name": { "type": "string", "minLength": 1 },
          "unit": { "type": "string", "minLength": 1 },
          "sellPriceVnd": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
