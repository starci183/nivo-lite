{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NIVO workspace records seed",
  "type": "object",
  "required": ["schema", "records"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "nivo/records-seed@1" },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["entity", "on", "values"],
        "additionalProperties": false,
        "properties": {
          "entity": { "type": "string", "pattern": "^[a-z][a-z0-9]*\\.[a-z][a-z0-9-]*$" },
          "on": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
          "values": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": { "type": ["string", "number", "boolean", "null"] }
          }
        }
      }
    }
  }
}
