{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NIVO workspace Brain documents seed",
  "type": "object",
  "required": ["schema", "origin", "documents"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "nivo/brain-seed@1" },
    "origin": { "type": "string", "pattern": "^seed:[a-z0-9][a-z0-9-]{0,39}$" },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "topic", "visibility", "content"],
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 200 },
          "topic": { "type": "string", "minLength": 1, "maxLength": 80 },
          "visibility": { "enum": ["public", "internal"] },
          "module": { "type": ["string", "null"], "minLength": 1, "maxLength": 60 },
          "content": { "type": "string", "minLength": 1, "maxLength": 100000 }
        }
      }
    }
  }
}
