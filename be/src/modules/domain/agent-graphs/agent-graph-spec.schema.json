{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "nivo/agent-graph@1"
    },
    "moduleKey": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,23}$"
    },
    "trigger": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "tag"
        },
        "sources": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["channel", "chats-group", "agent", "system-event", "schedule"]
          }
        },
        "burst": {
          "type": "object",
          "properties": {
            "channel": {
              "type": "object",
              "properties": {
                "window": {
                  "type": "string",
                  "pattern": "^[0-9]{1,6}(ms|s|m)$"
                },
                "maxWait": {
                  "type": "string",
                  "pattern": "^[0-9]{1,6}(ms|s|m)$"
                }
              },
              "required": ["window"],
              "additionalProperties": false
            },
            "chats-group": {
              "type": "object",
              "properties": {
                "window": {
                  "type": "string",
                  "pattern": "^[0-9]{1,6}(ms|s|m)$"
                },
                "maxWait": {
                  "type": "string",
                  "pattern": "^[0-9]{1,6}(ms|s|m)$"
                }
              },
              "required": ["window"],
              "additionalProperties": false
            },
            "agent": {
              "type": "object",
              "properties": {
                "window": {
                  "type": "string",
                  "pattern": "^[0-9]{1,6}(ms|s|m)$"
                },
                "maxWait": {
                  "type": "string",
                  "pattern": "^[0-9]{1,6}(ms|s|m)$"
                }
              },
              "required": ["window"],
              "additionalProperties": false
            },
            "system-event": {
              "type": "object",
              "properties": {
                "window": {
                  "type": "string",
                  "pattern": "^[0-9]{1,6}(ms|s|m)$"
                },
                "maxWait": {
                  "type": "string",
                  "pattern": "^[0-9]{1,6}(ms|s|m)$"
                }
              },
              "required": ["window"],
              "additionalProperties": false
            },
            "schedule": {
              "type": "object",
              "properties": {
                "window": {
                  "type": "string",
                  "pattern": "^[0-9]{1,6}(ms|s|m)$"
                },
                "maxWait": {
                  "type": "string",
                  "pattern": "^[0-9]{1,6}(ms|s|m)$"
                }
              },
              "required": ["window"],
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "required": ["kind", "sources"],
      "additionalProperties": false
    },
    "grant": {
      "type": "object",
      "properties": {
        "rights": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "access": {
                "type": "string",
                "enum": ["read", "write"]
              },
              "scope": {
                "type": "string",
                "enum": ["turn", "workspace"]
              },
              "fields": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "string",
                    "minLength": 1
                  }
                ],
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              }
            },
            "required": ["kind", "access", "scope", "fields"],
            "additionalProperties": false
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "effects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["rights", "tools", "effects"],
      "additionalProperties": false
    },
    "nodes": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "kind": {
            "type": "string",
            "enum": ["trigger", "condition", "execute", "output"]
          },
          "step": {
            "type": "string",
            "minLength": 1
          },
          "params": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "input": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "$ref": "#/$defs/__schema1"
            }
          },
          "next": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "routes": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            }
          }
        },
        "required": ["key", "kind", "step"],
        "additionalProperties": false
      }
    }
  },
  "required": ["schema", "moduleKey", "trigger", "grant", "nodes"],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    },
    "__schema1": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "$ref": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["$ref"],
          "additionalProperties": false
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema1"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema1"
          }
        }
      ]
    }
  },
  "title": "NIVO agent graph spec"
}
