{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "nivo/agent-graph@1"
    },
    "moduleKey": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^[a-z][a-z0-9_]{1,23}$"
    },
    "contract": {
      "type": "object",
      "properties": {
        "inputs": {
          "maxItems": 40,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 200,
                "pattern": "^[a-z][a-zA-Z0-9]{0,63}$"
              },
              "type": {
                "type": "string",
                "enum": [
                  "string",
                  "number",
                  "integer",
                  "boolean",
                  "object",
                  "array"
                ]
              },
              "required": {
                "type": "boolean"
              },
              "members": {
                "maxItems": 40,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "maxLength": 200,
                      "pattern": "^[a-z][a-zA-Z0-9]{0,63}$"
                    },
                    "type": {
                      "type": "string",
                      "enum": [
                        "string",
                        "number",
                        "integer",
                        "boolean",
                        "object",
                        "array"
                      ]
                    },
                    "required": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "name",
                    "type",
                    "required"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "name",
              "type",
              "required"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "inputs"
      ],
      "additionalProperties": false
    },
    "triggers": {
      "minItems": 1,
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "maxLength": 200,
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "source": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "zalo",
                  "telegram",
                  "facebook",
                  "instagram",
                  "website",
                  "sepay",
                  "timer",
                  "schedule",
                  "chats-group",
                  "workflow",
                  "provider"
                ]
              },
              "connectionId": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "provider": {
                "type": "string",
                "maxLength": 200,
                "pattern": "^[a-z][a-z0-9_]{1,30}$"
              },
              "trigger": {
                "type": "string",
                "maxLength": 200,
                "pattern": "^[a-z][a-z0-9.-]{1,60}$"
              }
            },
            "required": [
              "kind",
              "connectionId"
            ],
            "additionalProperties": false
          },
          "conditions": {
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "param": {
                  "type": "string",
                  "maxLength": 200,
                  "pattern": "^[a-z][a-zA-Z0-9]{0,63}(\\.[A-Za-z][A-Za-z0-9_-]{0,63}){0,2}$"
                },
                "op": {
                  "type": "string",
                  "enum": [
                    "equals",
                    "not-equals",
                    "in",
                    "contains",
                    "present"
                  ]
                },
                "value": {
                  "$ref": "#/$defs/__schema0"
                }
              },
              "required": [
                "param",
                "op"
              ],
              "additionalProperties": false
            }
          },
          "correlationKey": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "routeId",
                  "contactId",
                  "accountId",
                  "eventId"
                ]
              },
              {
                "type": "string",
                "pattern": "^data\\.[a-z][a-zA-Z0-9]{0,63}$"
              }
            ]
          }
        },
        "required": [
          "key",
          "source"
        ],
        "additionalProperties": false
      }
    },
    "outcomes": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "maxLength": 200,
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "outputs": {
            "maxItems": 40,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "maxLength": 200,
                  "pattern": "^[a-z][a-zA-Z0-9]{0,63}$"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "string",
                    "number",
                    "integer",
                    "boolean",
                    "object",
                    "array"
                  ]
                }
              },
              "required": [
                "name",
                "type"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "key",
          "label",
          "outputs"
        ],
        "additionalProperties": false
      }
    },
    "entry": {
      "type": "object",
      "properties": {
        "openTo": {
          "type": "string",
          "enum": [
            "any",
            "agent"
          ]
        }
      },
      "required": [
        "openTo"
      ],
      "additionalProperties": false
    },
    "trigger": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "tag"
        },
        "sources": {
          "minItems": 1,
          "maxItems": 5,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "channel",
              "chats-group",
              "agent",
              "system-event",
              "schedule"
            ]
          }
        }
      },
      "required": [
        "kind",
        "sources"
      ],
      "additionalProperties": false
    },
    "grant": {
      "type": "object",
      "properties": {
        "tools": {
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 200
          }
        },
        "effects": {
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 200
          }
        }
      },
      "required": [
        "tools",
        "effects"
      ],
      "additionalProperties": false
    },
    "nodes": {
      "minItems": 1,
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "maxLength": 200,
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "trigger",
              "condition",
              "execute",
              "output"
            ]
          },
          "step": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "params": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "maxLength": 200
            },
            "additionalProperties": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "input": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "maxLength": 200
            },
            "additionalProperties": {
              "$ref": "#/$defs/__schema1"
            }
          },
          "next": {
            "type": "string",
            "maxLength": 200,
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "routes": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "maxLength": 200
            },
            "additionalProperties": {
              "type": "string",
              "maxLength": 200,
              "pattern": "^[a-z][a-z0-9-]*$"
            }
          },
          "blocking": {
            "type": "boolean"
          },
          "group": {
            "type": "string",
            "maxLength": 200,
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "wait": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "reply",
                  "payment",
                  "other"
                ]
              },
              "timeout": {
                "type": "string",
                "maxLength": 200,
                "pattern": "^\\d{1,4}[dhm]$"
              },
              "reminder": {
                "type": "string",
                "maxLength": 200,
                "pattern": "^\\d{1,4}[dhm]$"
              }
            },
            "required": [
              "kind"
            ],
            "additionalProperties": false
          },
          "model": {
            "type": "string",
            "maxLength": 200,
            "pattern": "^[a-z0-9][a-z0-9./:-]{0,79}$"
          },
          "mode": {
            "type": "string",
            "enum": [
              "auto",
              "ask"
            ]
          },
          "accounts": {
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "maxLength": 200,
                  "pattern": "^[a-z][a-z0-9-]*$"
                },
                "provider": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "connectionId": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "operations": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "additionalProperties": {
                    "type": "string",
                    "enum": [
                      "auto",
                      "ask"
                    ]
                  }
                }
              },
              "required": [
                "kind",
                "provider",
                "connectionId"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "key",
          "kind",
          "step"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "moduleKey",
    "trigger",
    "grant",
    "nodes"
  ],
  "additionalProperties": false,
  "title": "NIVO agent graph spec",
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 4000
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "maxItems": 500,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "maxLength": 200
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    },
    "__schema1": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 4000
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "$ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "required": [
            "$ref"
          ],
          "additionalProperties": false
        },
        {
          "maxItems": 200,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema1"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "maxLength": 200
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema1"
          }
        }
      ]
    }
  }
}
