{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NIVO agent graph spec",
  "type": "object",
  "required": ["schema", "moduleKey", "trigger", "grant", "nodes"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "nivo/agent-graph@1" },
    "moduleKey": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,23}$" },
    "trigger": {
      "type": "object",
      "required": ["kind", "sources"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "tag" },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["channel", "chats-group", "agent", "system-event", "schedule"] }
        }
      }
    },
    "grant": {
      "type": "object",
      "required": ["rights", "tools", "effects"],
      "additionalProperties": false,
      "properties": {
        "rights": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "access", "scope", "fields"],
            "additionalProperties": false,
            "properties": {
              "kind": { "type": "string", "minLength": 1 },
              "access": { "enum": ["read", "write"] },
              "scope": { "enum": ["turn", "workspace"] },
              "fields": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
            }
          }
        },
        "tools": { "type": "array", "items": { "type": "string" } },
        "effects": { "type": "array", "items": { "type": "string" } }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["key", "kind", "step"],
        "additionalProperties": false,
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "kind": { "enum": ["trigger", "condition", "execute", "output"] },
          "step": { "type": "string", "minLength": 1 },
          "params": { "type": "object" },
          "input": { "type": "object" },
          "next": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "routes": { "type": "object" }
        }
      }
    }
  }
}
