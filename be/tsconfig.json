{
  "extends": "@starci/tsconfig/be.json",
  "compilerOptions": {
    "paths": {
      "@features/*": ["./src/features/*"],
      "@modules/*": ["./src/modules/*"],
      "@tests/*": ["./src/tests/*"],
      "@nivo/agent-sdk": ["./packages/agent-sdk/src/index.ts"],
      "@nivo/agent-sdk/*": ["./packages/agent-sdk/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", "src/tests/world", "src/tests/integration", "src/tests/e2e", "src/tests/contract"]
}
