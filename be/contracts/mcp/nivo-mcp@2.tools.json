    {
      "name": "nivo_call",
      "title": "Run a NIVO op",
      "description": "Run one op by its full name with its arguments, as the key's holder. It can change data: when nivo_describe_op says the op is destructive (delete, merge, unlink), describe what it will do to your user and wait for their yes first. A write needs an opKey (one per intended write, reused on retries).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 113,
            "description": "The full name of the op (from nivo_search_ops)."
          },
          "args": {
            "description": "The op's arguments, as its inputSchema (nivo_describe_op) says.",
            "type": "object",
            "propertyNames": {
              "type": "string",
              "maxLength": 200
            },
            "additionalProperties": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "opKey": {
            "description": "Required for an op that is not read-only: one stable key per intended write, reused on its retries.",
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "$defs": {
          "__schema0": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1048576
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              },
              {
                "maxItems": 10000,
                "type": "array",
                "items": {
                  "$ref": "#/$defs/__schema0"
                }
              },
              {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "maxLength": 200
                },
                "additionalProperties": {
                  "$ref": "#/$defs/__schema0"
                }
              }
            ]
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "op": {
            "type": "string",
            "maxLength": 113
          }
        },
        "required": [
          "op"
        ],
        "additionalProperties": {}
      },
      "annotations": {
        "title": "Run a NIVO op",
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": false
      },
      "_meta": {}
    },
