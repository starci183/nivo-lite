          },
          "readOnly": {
            "type": "boolean"
          },
          "destructive": {
            "type": "boolean"
          },
          "idempotent": {
            "type": "boolean"
          },
          "role": {
            "type": "string",
            "maxLength": 200
          },
          "inputSchema": {
            "type": "object",
            "properties": {},
