{
  "hfs": 2,
  "kind": "app",
  "edition": "lite",
  "project": "nivo-lite",
  "supabase": {
    "enableSignup": true,
    "jwtExpiry": 3600,
    "siteUrl": "http://localhost:3100",
    "redirectUrls": ["http://localhost:3100/**", "http://127.0.0.1:3100/**"]
  },
  "sides": {
    "be": {
      "apps": [
        { "name": "api", "kind": "api" },
        { "name": "cli", "kind": "cli" }
      ],
      "kinds": ["api", "cli", "jobs", "webhooks"],
      "connections": [
        {
          "name": "primary",
          "envPrefix": "PRIMARY_DB",
          "owner": "api",
          "isolation": "schema",
          "provider": "supabase"
        }
      ],
      "reads": ["supabase/types/"],
      "patterns": ["webhooks", "queue", "fenced-job"]
    },
    "fe": {
      "apps": [{ "name": "web", "kind": "next" }],
      "reads": ["be/contracts/", "supabase/types/"]
    }
  }
}
