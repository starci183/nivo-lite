{
  "hfs": 3,
  "kind": "app",
  "edition": "lite",
  "project": "nivo-lite",
  "supabase": {
    "enableSignup": true,
    "jwtExpiry": 3600,
    "siteUrl": "http://localhost:3000",
    "redirectUrls": ["http://localhost:3000/**", "http://127.0.0.1:3000/**"]
  },
  "sides": {
    "be": {
      "apps": [
        {
          "name": "api",
          "kind": "api"
        },
        {
          "name": "cli",
          "kind": "cli"
        }
      ],
      "kinds": ["api", "cli", "jobs", "webhooks"],
      "connections": [
        {
          "name": "primary",
          "envPrefix": "PRIMARY_DB",
          "owner": "api",
          "isolation": "schema",
          "provider": "supabase"
        }
      ],
      "reads": ["supabase/types/"],
      "patterns": ["webhooks", "queue", "fenced-job"],
      "optionalSlots": ["repo.docs", "be.contract.graphql", "repo.i18n-dynamic-keys"]
    },
    "fe": {
      "apps": [
        {
          "name": "web",
          "kind": "next"
        },
        {
          "name": "landing",
          "kind": "next"
        }
      ],
      "reads": ["be/contracts/", "supabase/types/"],
      "optionalSlots": ["fe.package.i18n", "repo.packages", "repo.i18n-dynamic-keys"],
      "extraPackages": [
        {
          "name": "@internationalized/date",
          "reason": "Date values (CalendarDate, parseDate) consumed by the HeroUI date and calendar pickers in the booking, accounting and sales screens."
        },
        {
          "name": "fflate",
          "reason": "Browser-side ZIP expansion for the Add documents drawer (modules/documents/zip.ts); pure, no server code."
        },
        {
          "name": "papaparse",
          "reason": "Browser-side CSV parsing for the import wizard (hooks/csv-import-wizard) before rows are uploaded."
        },
        {
          "name": "@types/papaparse",
          "reason": "Type declarations for papaparse."
        }
      ]
    }
  }
}
