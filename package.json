{
  "name": "nivo-lite",
  "version": "0.4.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "fe/apps/*",
    "fe/packages/*"
  ],
  "dependencies": {
    "@apollo/server": "5.5.1",
    "@as-integrations/express5": "1.1.2",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@nestjs/apollo": "13.4.5",
    "@nestjs/common": "11.2.5",
    "@nestjs/core": "11.2.5",
    "@nestjs/cqrs": "11.0.3",
    "@nestjs/graphql": "13.4.5",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/typeorm": "11.0.3",
    "@starci/ai-router": "0.3.0",
    "@supabase/supabase-js": "2.117.2",
    "bullmq": "6.3.11",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "fflate": "0.8.3",
    "graphql": "16.14.2",
    "imapflow": "2.4.0",
    "ioredis": "5.11.1",
    "jose": "6.2.12",
    "mailparser": "3.12.4",
    "mammoth": "1.13.0",
    "msedge-tts": "2.1.0",
    "mssql": "12.7.4",
    "mysql2": "3.24.5",
    "nest-commander": "3.21.0",
    "nodemailer": "10.2.1",
    "papaparse": "5.7.0",
    "pg": "8.23.1",
    "pg-types": "2.2.0",
    "read-excel-file": "9.3.12",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "telegram": "2.26.22",
    "tslib": "2.8.1",
    "typeorm": "0.3.31",
    "unpdf": "1.8.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.5",
    "@starci/eslint-canon-be": "3.6.4",
    "@starci/eslint-canon-fe": "9.4.5",
    "@starci/eslint-grammar-core": "0.15.6",
    "@starci/eslint-grammar-offset-pop": "0.15.6",
    "@starci/hfs": "4.9.8",
    "@starci/jest-preset": "2.4.1",
    "@starci/prettier-config": "1.1.0",
    "@starci/stylelint-canon": "2.2.1",
    "@starci/test-world": "1.2.3",
    "@starci/tsconfig": "2.1.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/express": "4.17.25",
    "@types/jest": "29.5.14",
    "@types/mssql": "12.3.0",
    "@types/node": "22.20.4",
    "@types/nodemailer": "8.0.2",
    "@types/papaparse": "5.5.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "husky": "9.1.7",
    "jest": "29.7.0",
    "postcss-value-parser": "4.2.0",
    "prettier": "3.9.6",
    "starci-harness": "1.1.0-alpha.5",
    "stylelint": "17.15.0",
    "supabase": "2.119.0",
    "tailwindcss": "4.3.3",
    "ts-jest": "29.4.12",
    "ts-node-dev": "2.0.0",
    "tsc-alias": "1.9.7",
    "tsconfig-paths": "4.2.0",
    "turbo": "2.11.6",
    "typescript": "5.9.3"
  },
  "scripts": {
    "prepare": "husky",
    "dev:be:api": "cd be && ts-node-dev --respawn -r tsconfig-paths/register apps/api/src/main.ts",
    "dev:be:mcp": "cd be && ts-node-dev --respawn -r tsconfig-paths/register apps/mcp/src/main.ts",
    "dev:fe:web": "npm run codegen --silent && turbo run dev --filter=@nivo-lite/web",
    "dev:fe:landing": "npm run codegen --silent && turbo run dev --filter=@nivo-lite/landing",
    "start:api": "node be/dist/apps/api/src/main.js",
    "cli": "node be/dist/apps/cli/src/main.js",
    "migrate": "node be/dist/apps/cli/src/main.js migrate run",
    "start:mcp": "node be/dist/apps/mcp/src/main.js",
    "start:web": "npm run start -w @nivo-lite/web",
    "start:landing": "npm run start -w @nivo-lite/landing",
    "docker:build": "npm run docker:build:api && npm run docker:build:cli && npm run docker:build:mcp && npm run docker:build:web && npm run docker:build:landing",
    "docker:build:api": "docker build -f be/apps/api/Dockerfile -t nivo-lite/api:dev .",
    "docker:build:cli": "docker build -f be/apps/cli/Dockerfile -t nivo-lite/cli:dev .",
    "docker:build:mcp": "docker build -f be/apps/mcp/Dockerfile -t nivo-lite/mcp:dev .",
    "docker:build:web": "docker build -f fe/apps/web/Dockerfile -t nivo-lite/web:dev .",
    "docker:build:landing": "docker build -f fe/apps/landing/Dockerfile -t nivo-lite/landing:dev .",
    "build:be": "cd be && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "build:fe": "npm run codegen --silent && turbo run build --filter=./fe/apps/*",
    "codegen": "node scripts/codegen.mjs",
    "codegen:graphql": "node scripts/codegen.mjs --graphql",
    "typecheck": "npm run codegen --silent && tsc -p be/tsconfig.json && turbo run typecheck",
    "lint": "npm run codegen --silent && turbo run build --filter=./fe/packages/* && starci app lint",
    "lint:fix": "npm run codegen --silent && turbo run build --filter=./fe/packages/* && starci app lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck:tests": "tsc -p be/src/tests/tsconfig.json",
    "test": "cd be && jest --selectProjects unit --coverage",
    "test:integration": "npm run typecheck:tests && cd be && jest --selectProjects integration",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:new": "supabase migration new",
    "db:push": "supabase db push",
    "db:types": "npm run contract:emit",
    "db:lint": "starci app check --fast",
    "redis:create": "docker create --name nivo-lite-dev-redis -p 127.0.0.1:6379:6379 -v nivo-lite-dev-redis-data:/data redis:7@sha256:c6eabf748fc7a61dbb5a705c78bcf3d6377b1127a97d0ce965c11c44ba46896f redis-server --appendonly yes",
    "redis:start": "docker start nivo-lite-dev-redis",
    "redis:stop": "docker stop nivo-lite-dev-redis",
    "contract:emit": "starci app emit"
  },
  "overrides": {
    "@azure/msal-node": "7.1.1",
    "body-parser": "2.4.0",
    "multer": "2.5.0",
    "tedious": {
      "@types/node": "$@types/node"
    },
    "axios": "1.20.0",
    "dayjs": "1.11.21",
    "@xyflow/react": {
      "zustand": "5.0.12"
    },
    "zod": "4.6.7",
    "@graphql-tools/utils": "12.1.0"
  }
}
